{
  "name": "living-atlas-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:board-wizard-quality": "npm run build && node scripts/test-board-wizard-quality.cjs",
    "test:board-wizard-narration": "npm run build && node scripts/test-board-wizard-narration.cjs",
    "test:board-wizard-commerce": "npm run build && node scripts/test-board-wizard-commerce.cjs",
    "test:board-wizard-menu": "npm run build && node scripts/test-board-wizard-menu.cjs",
    "test:board-wizard-reader": "npm run build && node scripts/test-board-wizard-reader.cjs",
    "test:board-wizard-article": "npm run build && node scripts/test-board-wizard-article.cjs",
    "test:board-wizard-video": "npm run build && node scripts/test-board-wizard-video.cjs",
    "test:board-translation": "npm run build && node scripts/test-board-translation.cjs",
    "test:spotify-oauth": "npm run build && node scripts/test-spotify-oauth.cjs",
    "test:visit-plans": "npm run build && node scripts/test-visit-plans.cjs",
    "test:visit-email-sandbox": "npm run build && node scripts/test-visit-email-sandbox.cjs",
    "test:city-place-search": "npm run build && node scripts/test-city-place-search.cjs",
    "test:bulk-board-generation": "npm run build && node scripts/test-bulk-board-generation.cjs",
    "test:university-board-generation": "npm run build && node scripts/test-university-board-generation.cjs",
    "test:city-board-listing": "npm run build && node scripts/test-city-board-listing.cjs",
    "test:stack-video-narration": "npm run build && node scripts/test-stack-video-narration.cjs",
    "repair:board-videos": "npm run build && node scripts/repair-board-videos.cjs",
    "city-pulse:refresh": "npm run build && node scripts/refresh-city-pulse.cjs",
    "clean": "rimraf lib",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "@mozilla/readability": "^0.6.0",
    "@sendgrid/mail": "^8.1.6",
    "@sparticuz/chromium": "^147.0.2",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.5.0",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.1",
    "pdf-parse": "^1.1.1",
    "puppeteer-core": "^24.42.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.3",
    "@types/pdf-parse": "^1.1.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
