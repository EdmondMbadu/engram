ll.","short_summary":"A large third-floor collaborative zone with whiteboards, charging, and adjustable desks.","evidence_claim":"The Open Study Area has long rectangular tables, charging outlets, whiteboards, and height-adjustable desks along its southern wall.","source_url":"https://www.lib.iastate.edu/visit-and-study/study-spaces/collaborative-spaces","source_title":"Collaborative Spaces | Iowa State University Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"This is a non-reservable third-floor collaboration zone; the library identifies it as one of its noisiest study areas.","cost_status":"unknown","under21_safe":true},{"subject_id":"isu-food-free-study-space","subject_type":"study_space","entity_name":"Food-free Study Space","title":"Food-free Study Space","subtitle":"Fourth floor, Parks Library","notes":"Choose a curved couch or a rolling-chair table for a quieter work session, and plan to keep food outside this fourth-floor study area.","short_summary":"A quieter fourth-floor setting with couches and tables for individuals or groups.","evidence_claim":"The Food-free Study Space is a quieter fourth-floor area with curved couches and tables with rolling chairs for individual or group work.","source_url":"https://www.lib.iastate.edu/visit-and-study/study-spaces/collaborative-spaces","source_title":"Collaborative Spaces | Iowa State University Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"A non-reservable, food-free study space on the fourth floor of Parks Library.","cost_status":"unknown","under21_safe":true},{"subject_id":"isu-maps-media-microforms","subject_type":"study_space","entity_name":"Maps, Media, and Microforms","title":"Maps, Media, and Microforms","subtitle":"Room 2, lower level of Parks Library","notes":"Set