:"https://www.atlantafed.org/who-we-are/visit/atlanta-monetary-museum","source_title":"Atlanta Monetary Museum | Federal Reserve Bank of Atlanta","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Self-guided visits run Monday–Friday, 9 a.m.–4 p.m. ET, except federal holidays; review security and identification rules first.","cost_status":"free","under21_safe":true},{"subject_id":"atlanta-beltline-public-art-walk","subject_type":"activity","entity_name":"Art on the Atlanta Beltline","title":"Walk an Open-Air Art Exhibit","subtitle":"Explore free murals and sculptures along the Atlanta Beltline","notes":"Choose a manageable trail segment, use the official art information to locate works, and pause for one group photo along the route.","short_summary":"A flexible outdoor art walk combining conversation, movement, and changing installations.","evidence_claim":"Atlanta Beltline’s official visitor page identifies Art on the Atlanta Beltline as a free public-art exhibition.","source_url":"https://beltline.org/visit/","source_title":"Visit the Atlanta Beltline","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The exhibition requires no admission; select a daylight route, check trail alerts, and budget separately for optional transportation.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
