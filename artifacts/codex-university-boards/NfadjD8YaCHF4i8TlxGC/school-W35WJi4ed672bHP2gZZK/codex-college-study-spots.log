hed_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Study rooms require booking; UMD’s policy limits regular reservations to three hours per day and requires key pickup from the first-floor Library Services Desk.","cost_status":"unknown","under21_safe":true},{"subject_id":"umd-third-floor-quiet-zone","subject_type":"study_space","entity_name":"Third-Floor Quiet Zone","title":"Third-Floor Quiet Zone","subtitle":"Kathryn A. Martin Library, floor 3","notes":"Head to the third floor for a quiet-study designation and choose a seat that matches a reading, writing, or individual research task.","short_summary":"A library floor explicitly designated for quiet study.","evidence_claim":"UMD designates the third and fourth floors of the Kathryn A. Martin Library as focused quiet-study space.","source_url":"https://lib.d.umn.edu/about/library-spaces","source_title":"Library Spaces | Kathryn A. Martin Library | University of Minnesota Duluth","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"This is a quiet-study designation; consult the library floor maps for seating and nearby services.","cost_status":"unknown","under21_safe":true},{"subject_id":"umd-fourth-floor-quiet-zone","subject_type":"study_space","entity_name":"Fourth-Floor Quiet Zone","title":"Fourth-Floor Quiet Zone","subtitle":"Kathryn A. Martin Library, floor 4","notes":"Choose the fourth floor for a focused quiet-study session, especially when you want to pair individual work with a reservable sensory study room.","short_summary":"A quiet-study floor that also contains the library’s sensory-equipped study rooms.","evidence_claim":"UMD designates the third and fourth floors of the Kathryn A. Martin Library as focused quiet-study space, and identifies study rooms on the fourth floor as sensory-equipped.","source_url":"https://lib.d.umn.edu/about/library-spaces","source_title":"Library Spaces | Kathryn A. Martin Library | University of Minnesota Duluth","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Use the floor’s quiet-study designation; reservable study rooms have separate booking and key-pickup requirements.","cost_status":"unknown","under21_safe":true},{"subject_id":"umd-calm-corner","subject_type":"study_space","entity_name":"Calm Corner","title":"Calm Corner","subtitle":"Kathryn A. Martin Library","notes":"Take a brief reset with the available coloring, puzzles, or spirographs, then return to your reading or writing task with a refreshed plan.","short_summary":"An anytime-the-library-is-open corner with rotating calming activities.","evidence_claim":"UMD states that the library’s Calm Corner provides rotating calming activities, including coloring, puzzles, and spirographs, and is available whenever the library is open.","source_url":"https://lib.d.umn.edu/about/library-spaces","source_title":"Library Spaces | Kathryn A. Martin Library | University of Minnesota Duluth","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Available anytime the library is open; activity supplies are swapped out regularly.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
