www.visitphilly.com/articles/philadelphia/top-free-philadelphia-attractions/","source_title":"40+ Free Things to Do in Greater Philadelphia","source_kind":"other_reliable","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The sculpture is in the outdoor public space of LOVE Park; park amenities and nearby vendors may charge separately.","cost_status":"free","under21_safe":true},{"subject_id":"dilworth-park","subject_type":"place","entity_name":"Dilworth Park","title":"Use Dilworth Park's public space","subtitle":"1 S. 15th Street, beside Philadelphia City Hall","notes":"Bring a friend to sit under the tree groves, walk through the plaza, or check the calendar for a free lawn screening or performance.","short_summary":"An outdoor City Hall plaza with no admission charge.","evidence_claim":"Visit Philadelphia states that there is no cost of admission to visit Dilworth Park.","source_url":"https://www.visitphilly.com/things-to-do/attractions/dilworth-park-at-city-hall/","source_title":"Dilworth Park","source_kind":"other_reliable","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Outdoor public space; skating, food, and other programmed amenities can have separate charges.","cost_status":"free","under21_safe":true},{"subject_id":"rail-park-phase-one","subject_type":"place","entity_name":"The Rail Park, Phase One","title":"Walk The Rail Park","subtitle":"1300 Noble Street entrance; also Callowhill Street between 11th and 12th","notes":"Enter at Noble Street for the accessible slope, then take a slow loop past benches, plantings, industrial artwork, and the Story Wall.","short_summary":"A free elevated park built on former Reading Railroad tracks.","evidence_claim":"The Rail Park's official site states that Phase One is free and open daily.","source_url":"https://www.therailpark.org/","source_title":"The Rail Park","source_kind":"business_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Phase One is free and open daily; use the Noble Street entrance for wheelchair-accessible access.","cost_status":"free","under21_safe":true},{"subject_id":"spruce-street-harbor-park","subject_type":"place","entity_name":"Spruce Street Harbor Park","title":"Lounge at Spruce Street Harbor Park","subtitle":"Penn's Landing waterfront","notes":"Use the seating, lights, floating gardens, and hammocks for a waterfront meetup; skip the optional concessions and paid activities.","short_summary":"A seasonal public waterfront park with free entry.","evidence_claim":"Visit Philadelphia states that Spruce Street Harbor Park is free and open to the public through September, with concessions and select activities separate.","source_url":"https://www.visitphilly.com/things-to-do/attractions/spruce-street-harbor-park/","source_title":"Spruce Street Harbor Park: 5 New & Surprising Things to Do for 2026","source_kind":"other_reliable","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Seasonal and free through September; concessions and select activities are pay-as-you-go.","cost_status":"free","under21_safe":true},{"subject_id":"rocky-steps","subject_type":"activity","entity_name":"Rocky Steps","title":"Climb the Rocky Steps","subtitle":"Philadelphia Museum of Art, 2600 Benjamin Franklin Parkway","notes":"Take the outdoor staircase at your own pace, pause at the top for the skyline view, and keep the visit outside the museum's ticketed galleries.","short_summary":"A free outdoor stair climb and skyline-view stop at the Philadelphia Museum of Art.","evidence_claim":"Visit Philadelphia identifies the Rocky Steps as free and says visitors can run the steps or visit the Rocky Statue without museum admission.","source_url":"https://www.visitphilly.com/articles/philadelphia/top-free-philadelphia-attractions/","source_title":"40+ Free Things to Do in Greater Philadelphia","source_kind":"other_reliable","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"This card covers the exterior steps only; entry to the Philadelphia Museum of Art galleries is separate.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
