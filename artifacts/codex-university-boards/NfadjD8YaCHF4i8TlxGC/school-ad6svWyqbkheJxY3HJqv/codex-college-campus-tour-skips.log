ource_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"A reservation is required to use the room.","cost_status":"unknown","under21_safe":true},{"subject_id":"marquette-center-for-engagement-and-inclusion","subject_type":"place","entity_name":"Center for Engagement and Inclusion","title":"Center for Engagement and Inclusion","subtitle":"Alumni Memorial Union, room 111","notes":"Drop into the CEI to connect with multicultural student organizations or use its interaction and study space; staff are available in nearby AMU 121 when needed.","short_summary":"An AMU space for student interaction, study, and multicultural student-organization use.","evidence_claim":"Marquette states that the Center for Engagement and Inclusion in AMU Room 111 provides student interaction and study spaces and space for multicultural student organizations.","source_url":"https://www.marquette.edu/inclusion-belonging/center/","source_title":"Center for Engagement and Inclusion | Marquette University","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The center is open when the Alumni Memorial Union is open; visit AMU 121 to see a staff member.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
