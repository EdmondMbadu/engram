mark","notes":"Walk the public approach to the stadium and nearby athletic buildings, then check the official athletics schedule if you want to plan a future game day.","short_summary":"A 22,000-seat campus venue used beyond game days.","evidence_claim":"UD describes Delaware Stadium as a 22,000-seat venue used throughout the year, not only on game days.","source_url":"https://www.udel.edu/alumni-friends/delaware-first/transforming-campus/","source_title":"Transforming Campus | Alumni & Friends | University of Delaware","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Outdoor viewing is appropriate; event entry, tickets, and venue access depend on the specific event.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
