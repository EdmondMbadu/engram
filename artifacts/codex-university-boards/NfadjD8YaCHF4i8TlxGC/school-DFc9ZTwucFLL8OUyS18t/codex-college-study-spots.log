 dining hours.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"curtis-terrace","subject_type":"study_space","entity_name":"Curtis Terrace","title":"Take the Reading Outside","subtitle":"Tables and chairs beside Reilly Hall","notes":"Bring a short reading or review task when the weather is comfortable; tables, chairs, and green space support an outdoor study session.","short_summary":"An outdoor terrace for reading or brief study between nearby classes.","evidence_claim":"Le Moyne describes Curtis Terrace beside Reilly Hall as having tables, chairs, and green space for reading or last-minute studying.","source_url":"https://www.lemoyne.edu/news/campus-hotspots-youll-love/","source_title":"Campus Hotspots You'll Love","source_kind":"university_official","source_published_at":"2026-01-09","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Outdoor space beside Reilly Hall; practical access depends on weather and any current campus restrictions.","cost_status":"not_applicable","under21_safe":true}],"warnings":[]}],"warnings":[]}
