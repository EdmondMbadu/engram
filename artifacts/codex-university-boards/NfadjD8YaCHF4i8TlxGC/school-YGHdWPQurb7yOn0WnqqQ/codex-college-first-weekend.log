.","source_url":"https://lib.ku.edu/locations/watson","source_title":"Watson Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Study rooms support academic study and research; check the library’s current hours and room-reservation availability before going.","cost_status":"unknown","under21_safe":true},{"subject_id":"ku-debruce-center","subject_type":"sequence_stop","entity_name":"DeBruce Center","title":"See basketball’s original rules at DeBruce","subtitle":"History stop · 1647 Naismith Drive","notes":"Look for the original Rules of Basket Ball and the Naismith statue outside, then use the adjoining student-center spaces as a breather.","short_summary":"A KU student center adjoining Allen Fieldhouse and housing Naismith’s original rules.","evidence_claim":"KU says the DeBruce Center houses James Naismith’s original Rules of Basket Ball and includes student-center amenities and meeting rooms.","source_url":"https://places.ku.edu/buildings/debruce-center","source_title":"DeBruce Center","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The building is connected to Allen Fieldhouse; the Union publishes current operating hours and notes game-related closures.","cost_status":"unknown","under21_safe":true},{"subject_id":"ku-ambler-student-recreation-fitness-center","subject_type":"sequence_stop","entity_name":"Ambler Student Recreation Fitness Center","title":"Finish with a low-pressure Rec orientation","subtitle":"Active reset · 1740 Watkins Center Drive","notes":"Bring your KUID, check in at the Welcome Center, and take a first lap through the track, courts, and equipment areas at your pace.","short_summary":"A KU recreation facility with fitness equipment, courts, a track, climbing wall, and table games.","evidence_claim":"KU says Ambler SR