A public museum space within the Basilica complex.","evidence_claim":"The Basilica Museum is open to the public when indicated by signage, and Basilica admission is free.","source_url":"https://basilica.nd.edu/about/visit-and-tours/","source_title":"Visits and Tours | Basilica of the Sacred Heart","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Museum availability varies; confirm the posted sign and note that liturgies or events can close touring areas.","cost_status":"free","under21_safe":true},{"subject_id":"hesburgh-library","subject_type":"place","entity_name":"Hesburgh Library","title":"Use the visitor-friendly library","subtitle":"284 Hesburgh Library","notes":"Meet on the first floor, browse the catalog or use a research workstation, and plan a quiet reading or research session together.","short_summary":"Visitor access to library spaces, collections, and research workstations.","evidence_claim":"Hesburgh Library is open to visitors, welcomes everyone to use collections on site, and provides research workstations without NetID login.","source_url":"https://www.library.nd.edu/visitor-information/","source_title":"Visitor Information | Hesburgh Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Visitors are asked to leave at 8 p.m., when the building becomes exclusive to current Notre Dame students, faculty, and staff.","cost_status":"free","under21_safe":true},{"subject_id":"eck-visitors-center-campus-tour","subject_type":"activity","entity_name":"Notre Dame Public Campus Tour","title":"Join the free public campus tour","subtitle":"Starts at Eck Visitors Center","notes":"Register in person at the Eck Visitors Center on the day you visit, then use the student-led walk to orient your group to campus landmarks.","short_summary":"A free, student-led introduction to signature Notre Dame sites.","evidence_claim":"Notre Dame’s public campus tours are free year-round, register in person, and highlight the Golden Dome, Basilica, Grotto, and Word of Life mural.","source_url":"https://www.nd.edu/about/visit/","source_title":"Visit | University of Notre Dame","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Register in person on the day of your visit at Eck Visitors Center; tour availability may vary.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
