us":"free","under21_safe":true},{"subject_id":"butler-broad-ripple-avenue-park","subject_type":"street_or_district","entity_name":"Broad Ripple Park","title":"Follow Broad Ripple Avenue to the White River","subtitle":"Broad Ripple Avenue east of the Monon Trail","notes":"Use Broad Ripple Avenue for a park outing with river views, walking paths, outdoor courts and the wooded trails of the 10 Acre Woods.","short_summary":"The avenue ends at a named riverfront park with paths, courts, woods, and recreation facilities.","evidence_claim":"Indy Parks locates Broad Ripple Park at 1500 Broad Ripple Ave and documents White River views, walking trails, outdoor courts, and the 10 Acre Woods.","source_url":"https://parks.indy.gov/parks/broad-ripple-park/","source_title":"Broad Ripple Park - Indy Parks & Recreation","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Park grounds are open dawn to dusk. Pool use, classes, or other programmed facilities may have separate fees or schedules.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
