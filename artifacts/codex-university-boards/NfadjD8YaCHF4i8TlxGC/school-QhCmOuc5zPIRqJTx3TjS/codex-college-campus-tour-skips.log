amu.edu/spaces/types/kelsey.php","source_title":"Kelsey Reading Room | Texas A&M University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The page lists standard hours of Monday–Friday, 9:00 a.m.–4:30 p.m.; check library hours for changes.","cost_status":"unknown","under21_safe":true},{"subject_id":"tamu-maker-zone","subject_type":"place","entity_name":"Maker Zone","title":"Maker Zone","subtitle":"Sterling C. Evans Library","notes":"Bring a valid Aggie ID and try a hands-on project with the available crafting equipment; workshops and open-studio sessions are offered during semesters.","short_summary":"A library makerspace for sewing, cutting-machine, and craft projects.","evidence_claim":"The Maker Zone is an experiential learning space for current Texas A&M students, faculty, and staff, with workshops and open studio times.","source_url":"https://library.tamu.edu/about/welcome-new-students.php","source_title":"Welcome New Students | Texas A&M University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Valid Aggie ID is required; access is for current students, faculty, and staff affiliated with Texas A&M.","cost_status":"unknown","under21_safe":true},{"subject_id":"tamu-the-studio","subject_type":"place","entity_name":"The Studio","title":"The Studio","subtitle":"Evans Annex, sixth floor, Room 3.653","notes":"Reserve a Studio space when a project calls for audio, video, graphics, or multimedia work; the One Button Studio needs only a flash drive.","short_summary":"A media-production space with specialized equipment and project support.","evidence_claim":"The Studio provides tools and assistance for graphics, video, audio, and multimedia projects and is located in Evans Annex Room 3.653.","source_url":"https://library.tamu.edu/spaces/the-studio","source_title":"The Studio | Texas A&M University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Reserve a Studio space through the Libraries; bring a flash drive for the One Button Studio.","cost_status":"unknown","under21_safe":true},{"subject_id":"tamu-assistive-technology-room","subject_type":"place","entity_name":"Assistive Technology Room","title":"Assistive Technology Room","subtitle":"Evans Library, first floor, Room 108F","notes":"Use the adaptive workstations, magnification, scanning, and text-to-speech tools; stop by the AskUs Desk if you need help locating it.","short_summary":"A first-floor Evans room with adaptive technology and loanable devices.","evidence_claim":"The Assistive Technology Room in Evans Library supports students, faculty, staff, and community users with disabilities and is first-come, first-served.","source_url":"https://library.tamu.edu/spaces/types/assistive.php","source_title":"Assistive Technology Room | Texas A&M University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"First-come, first-served; AskUs Desk staff can assist with finding the room.","cost_status":"unknown","under21_safe":true},{"subject_id":"tamu-student-veteran-study-room","subject_type":"study_space","entity_name":"Student Veteran Study Room","title":"Student Veteran Study Room","subtitle":"Evans Library, second floor, Room 252C","notes":"Eligible student veterans can arrange swipe access, then use the collaborative table, soft seating, computers, and whiteboard wall for coursework.","short_summary":"Dedicated Evans Library study room for student veterans.","evidence_claim":"The Student Veteran Study Room in Evans Library is a dedicated space with a collaborative table, soft seating, OAL computers, and a whiteboard wall.","source_url":"https://library.tamu.edu/spaces/types/veteran.php","source_title":"Student Veteran Study Room | Texas A&M University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Access is limited to student veterans whose student ID has been coded for swipe-card entry.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
