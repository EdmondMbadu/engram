g.","evidence_claim":"Calvin states that its campus observatory has an educational mission, is used by students at all levels, and opens to Calvin students on clear weekday evenings during fall and spring semesters.","source_url":"https://calvin.edu/places/calvin-observatory","source_title":"Calvin Observatory Physics and Astronomy | Calvin University","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":42.931015,"longitude":-85.58867,"maps_url":null,"access_notes":"Access is weather-dependent and limited to posted sessions. The dome requires stairs; portable-telescope viewing can be arranged for wheelchair access.","cost_status":"unknown","under21_safe":true},{"subject_id":"calvin-climbing-center","subject_type":"place","entity_name":"Calvin Climbing Center","title":"Learn the wall with trained instruction","subtitle":"A 40-foot indoor wall in the Spoelhof Fieldhouse Complex","notes":"Bring a signed waiver, check in with staff, and use the first-timer training before attempting belayed routes.","short_summary":"A student recreation space with changing routes, supervised sessions, and beginner instruction.","evidence_claim":"Calvin documents a 40-foot-tall climbing center with more than 50 changing routes, trained instructional staff, first-timer training, and free access for Calvin students, faculty, and staff.","source_url":"https://calvin.edu/places/calvin-climbing-center","source_title":"Calvin Climbing Center | Calvin University","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Only Calvin students, faculty, and staff may use the center. Climb solely during staffed program hours after completing the required waiver and instruction.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
