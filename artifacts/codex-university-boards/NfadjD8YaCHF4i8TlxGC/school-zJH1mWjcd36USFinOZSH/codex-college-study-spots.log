ubtitle":"Miller Nichols Library · regular conversation","notes":"Choose a table, soft seating, or a reservable group room on the renovated floor when you want nearby power and a setting suited to collaborative work.","short_summary":"Renovated group-friendly study areas with flexible seating and reservable rooms.","evidence_claim":"The renovated Fourth Floor has study areas, 304 student-study seats, technology-enabled rooms, nearby outlets, and reservable group rooms for 3–8 people.","source_url":"https://library.umkc.edu/fourth-floor/","source_title":"Renovated Library Fourth Floor Open","source_kind":"university_official","source_published_at":"2025-06-02","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Study spaces are open while the library is open; many rooms can be reserved up to one week ahead in two-hour blocks.","cost_status":"unknown","under21_safe":true},{"subject_id":"umkc-hsl-silent-study-area","subject_type":"study_space","entity_name":"Health Sciences Library Silent Study Area","title":"Health Sciences Library Silent Study","subtitle":"Health Sciences Library · north end","notes":"Head to the north-end silent area for uninterrupted individual work, and keep calls, conversation, and group work outside the designated zone.","short_summary":"A designated silent area in UMKC’s Health Sciences Library.","evidence_claim":"UMKC Libraries identifies the north end of the Health Sciences Library as a designated silent area; its floor plan also lists a Silent Study Area.","source_url":"https://library.umkc.edu/welcome/","source_title":"Welcome! — UMKC Libraries","source_kind":"university_official","source_published_at":"2025-08-22","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"No conversation, group study, or cell-phone talking is allowed in designated silent-study areas.","cost_status":"unknown","under21_safe":true},{"subject_id":"umkc-hsl-active-study-room","