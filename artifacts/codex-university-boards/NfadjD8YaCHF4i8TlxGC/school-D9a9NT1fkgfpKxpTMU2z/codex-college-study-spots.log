groups of five to six.","source_url":"https://library.illinoisstate.edu/services/technology/collaboration-station/","source_title":"Collaboration Stations | Milner Library | Illinois State","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Connect with HDMI or USB-C; the library says no software, adapters, or configuration are required.","cost_status":"unknown","under21_safe":true},{"subject_id":"milner-floor-4-drop-in-offices","subject_type":"study_space","entity_name":"Milner Library Floor 4 Drop-in Offices","title":"Floor 4 Drop-in Offices","subtitle":"Milner Library · 422 and 429 office blocks","notes":"Plug a compatible laptop into the USB-C monitor for keyboard, video, mouse, and power, then use the desk and whiteboard for independent work.","short_summary":"Office-style individual workspaces with a wired monitor setup.","evidence_claim":"Milner’s Floor 4 Drop-in Offices provide a 24-inch USB-C monitor, keyboard, mouse, whiteboard, desk space, and power hookups.","source_url":"https://library.illinoisstate.edu/services/technology/drop-in-office/","source_title":"Drop-in Offices | Milner Library | Illinois State","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Located in the northeast and southeast corners of Floor 4 in the 422 and 429 office blocks; designed for compatible USB-C laptops.","cost_status":"unknown","under21_safe":true},{"subject_id":"milner-library-workstations","subject_type":"study_space","entity_name":"Milner Library Computer Workstations","title":"Milner Computer Workstations","subtitle":"Milner Library · Floors 2–6","notes":"Choose a first-come workstation when coursework needs campus software; use the specialty stations in 213B for low-vision, audio, or visual work.","short_summary":"Library computers with broad software and specialty options.","evidence_claim":"Milner provides Windows workstations on Floors 2 through 6 on a first-come, first-served basis, with specialty workstations in Room 213B.","source_url":"https://library.illinoisstate.edu/services/technology/workstations/","source_title":"Library Workstations | Milner Library | Illinois State","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Workstations are first come, first served. Non-university users must check in at the main-floor Service Desk.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
