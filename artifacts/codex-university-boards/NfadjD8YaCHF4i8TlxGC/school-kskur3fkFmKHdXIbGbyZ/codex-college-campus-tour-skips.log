y","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Events and ticket requirements vary; confirm entry details on the event listing before attending.","cost_status":"unknown","under21_safe":true},{"subject_id":"sdsu-first-bank-trust-arena","subject_type":"place","entity_name":"First Bank & Trust Arena","title":"First Bank & Trust Arena","subtitle":"1165 Jackrabbit Ave. — home venue for basketball, volleyball and wrestling","notes":"Follow the athletics schedule for a game or match, and use the west-side student entrance when attending as a student; allow time for event entry.","short_summary":"The renovated Jackrabbit competition venue with dedicated student access.","evidence_claim":"SDSU identifies First Bank & Trust Arena as the home competition venue for Jackrabbit basketball, volleyball and wrestling, with a west-side student entrance.","source_url":"https://www.sdstate.edu/buildings/first-bank-trust-arena","source_title":"First Bank & Trust Arena building | South Dakota State University","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Access depends on the scheduled event and its entry policies; consult SDSU Athletics for current details.","cost_status":"unknown","under21_safe":true},{"subject_id":"sdsu-agricultural-heritage-museum","subject_type":"place","entity_name":"South Dakota Agricultural Heritage Museum","title":"South Dakota Agricultural Heritage Museum","subtitle":"977 11th St. — state agricultural-history collections on campus","notes":"Walk through the exhibits to connect campus agriculture with statewide rural history, then check the museum’s current exhibit information before planning a return visit.","short_summary":"A campus museum preserving and interpreting South Dakota agricultural and rural history.","evidence_claim":"SDSU identifies the South Dakota Agricultural Heritage Museum as the official state museum for collecting, preserving and interpreting South Dakota agriculture and rural life.","source_url":"https://www.sdstate.edu/south-dakota-agricultural-heritage-museum/about-agricultural-heritage-museum","source_title":"About the Agricultural Heritage Museum | South Dakota State University","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"SDSU lists daily visitor hours, with Sunday closures from January through March; verify before going.","cost_status":"unknown","under21_safe":true},{"subject_id":"sdsu-davis-dairy-plant","subject_type":"place","entity_name":"Davis Dairy Plant","title":"Davis Dairy Plant","subtitle":"1225 College Ave. — student dairy production and Dairy Bar","notes":"Stop by during listed business hours to see the campus dairy operation’s public-facing setting; purchases at the Dairy Bar are separate from simply visiting.","short_summary":"A working dairy facility where SDSU students make products sold through the Dairy Bar.","evidence_claim":"SDSU states that students process milk into finished dairy products at the Davis Dairy Plant and that visitors can see students making ice cream through Dairy Bar windows.","source_url":"https://www.sdstate.edu/buildings/davis-dairy-plant","source_title":"Davis Dairy Plant building | South Dakota State University","source_kind":"university_official","source_published_at":"2011-10-21","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"SDSU lists Davis Dairy Plant hours as Monday-Friday, 8 a.m.-5 p.m.; Dairy Bar availability may differ.","cost_status":"purchase_required","under21_safe":true}],"warnings":[]}],"warnings":[]}
