ce_kind":"business_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Consult individual tenant listings for current hours and availability.","cost_status":"purchase_required","under21_safe":true},{"subject_id":"malibu-lagoon-state-beach","subject_type":"street_or_district","entity_name":"Malibu Lagoon State Beach","title":"Malibu Lagoon State Beach","subtitle":"Pacific Coast Highway–Cross Creek Road corridor","notes":"Enter from Cross Creek Road for the nature area, then take the trails slowly for lagoon and beach views while respecting posted habitat rules.","short_summary":"A state beach where Malibu Creek reaches the Pacific, with trails and wildlife viewing.","evidence_claim":"California State Parks says Malibu Lagoon State Beach has nature trails, bird-watching, lagoon views, and beach access, with parking/nature-area entry at Cross Creek Road.","source_url":"https://www.parks.ca.gov/?kui=2Yq1Vlj31jfe1tT1MDxpag&page_id=835","source_title":"Malibu Lagoon State Beach","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Day-use parking is listed 8 AM–sunset; parking fees apply. Dogs are not allowed on lagoon trails or the beach.","cost_status":"purchase_required","under21_safe":true},{"subject_id":"adamson-house","subject_type":"street_or_district","entity_name":"Adamson House","title":"Adamson House","subtitle":"Pacific Coast Highway corridor beside Malibu Lagoon","notes":"See the historic house and its Malibu tile details, or time a visit for the adjoining museum and grounds; check weather-related closures first.","short_summary":"A California State Parks historic house and museum destination beside the lagoon.","evidence_claim":"California State Parks identifies Adamson House at 23200 Pacific Coast Highway and describes its historic house, grounds, Malibu tile, and adjoining Malibu Lagoon Museum.","source_url":"https://parks.ca.gov/?lang=en&page_id=672","source_title":"Adamson House","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The State Parks page says the museum is free, Wednesday–Saturday 11 AM–3 PM; house/museum closures can occur during rain.","cost_status":"unknown","under21_safe":true},{"subject_id":"malibu-pier","subject_type":"street_or_district","entity_name":"Malibu Pier","title":"Malibu Pier","subtitle":"Pacific Coast Highway corridor","notes":"Walk the publicly open portion for the landmark structure and coastal views, and check the State Parks closure notice before planning a full-length stroll.","short_summary":"A historic oceanfront pier with current access limited at its far end.","evidence_claim":"California State Parks reports that the rest of Malibu Pier remains open to the public while its end is temporarily closed for structural safety concerns.","source_url":"https://www.parks.ca.gov/?page_id=31818","source_title":"FAQs: Temporary Closure of the End of Malibu Pier","source_kind":"government","source_published_at":"2025-11-10","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The far end remains temporarily closed; review the State Parks update before visiting.","cost_status":"unknown","under21_safe":true},{"subject_id":"malibu-equestrian-park","subject_type":"street_or_district","entity_name":"Malibu Equestrian Park","title":"Malibu Equestrian Park","subtitle":"Merritt Drive–Morning View Drive corridor","notes":"If you already ride, use the public practice and recreational-riding access; otherwise, stop by only when an authorized lesson or event is available.","short_summary":"A public equestrian facility with two riding arenas next to Malibu High School.","evidence_claim":"The City lists Malibu Equestrian Park at 6225 Merritt Drive with two riding arenas, picnic area, restrooms, and public practice/recreational-riding access.","source_url":"https://www.malibucity.org/facilities/facility/details/Malibu-Equestrian-Park-11","source_title":"Malibu Equestrian Park","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Listed hours are 8 AM to sunset; horse shows and lessons use facility-rental arrangements.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
