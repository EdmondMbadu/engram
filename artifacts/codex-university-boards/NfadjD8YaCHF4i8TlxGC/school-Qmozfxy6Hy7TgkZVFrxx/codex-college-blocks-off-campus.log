pretation.","short_summary":"A historic house combines visitor services with small museum displays.","evidence_claim":"Harrisonburg Tourism lists the center at 212 S Main Street and documents its travel desk, maps, Valley Turnpike Museum, and Civil War Orientation Center.","source_url":"https://visitharrisonburgva.com/about-us/hardesty-higgins-house-visitor-center/","source_title":"Hardesty-Higgins House Visitor Center - Harrisonburg","source_kind":"government","source_published_at":"2025-12-30","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The official page lists daily visitor-center hours of 9 a.m.–5 p.m., with specified holiday closures and limited holiday exceptions.","cost_status":"free","under21_safe":true},{"subject_id":"jmu-blocks-massanutten-library","subject_type":"street_or_district","entity_name":"Massanutten Regional Library – Central Library","title":"Use the Downtown Public Library","subtitle":"South Main Street corridor","notes":"Bring a reading or research task to the Central Library, then pair the stop with Denton Park directly across South Main Street.","short_summary":"The regional system’s Harrisonburg branch and offices occupy a central downtown address.","evidence_claim":"Massanutten Regional Library identifies its Central Library and administrative offices at 174 S Main Street in Harrisonburg.","source_url":"https://mrlib.org/about-us/contact.html","source_title":"Contact Us : About Us : Massanutten Regional Library","source_kind":"cultural_institution","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Public-library services and building schedules may vary; check the branch’s current hours before departure.","cost_status":"free","under21_safe":true},{"subject_id":"jmu-blocks-explore-more","subject_type":"street_or_district","entity_name":"Explore More Discovery Museum","title":"Try an Interactive Exhibit Floor","subt