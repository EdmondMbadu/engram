{"complete":true,"school_name":"James Madison University","town_name":"Harrisonburg","boards":[{"complete":true,"school_name":"James Madison University","town_name":"Harrisonburg","template_id":"college-first-weekend","title":"Your First Weekend at James Madison University, Shared as Cards","description":"A Friday-to-Sunday sequence connecting JMU landmarks, student recreation, public science, green space, and downtown Harrisonburg without assuming a particular event calendar.","icon":"schedule","cards":[{"subject_id":"jmu-quad-friday-start","subject_type":"sequence_stop","entity_name":"The Quad","title":"Start Friday on the Quad","subtitle":"Friday afternoon · Historic Bluestone campus","notes":"Begin beneath Wilson Hall, walk the Bluestone paths, and use this open campus landmark to orient yourself before heading indoors.","short_summary":"Get your bearings in JMU’s historic campus core.","evidence_claim":"JMU identifies the Quad as its oldest campus area, lined by Bluestone buildings, capped by Wilson Hall, and used as a gathering space for more than 110 years.","source_url":"https://www.jmu.edu/admissions/explore/spirit-traditions.shtml","source_title":"Spirit and Traditions - JMU","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"An outdoor campus landmark; follow posted campus restrictions and avoid disrupting scheduled activities.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"little-jimmy-photo-stop","subject_type":"sequence_stop","entity_name":"James Madison Statue (Little Jimmy)","title":"Meet Little Jimmy","subtitle":"Friday afternoon · Between Varner House and Logan Hall","notes":"Find the life-size Madison statue near the Quad and take a quick group photo before continuing toward The Union.","short_summary":"Put a face—and a photo stop—to the university’s namesake.","evidence_claim":"JMU documents the campus statue nicknamed Little Jimmy as a favorite photo location and says its 5-foot-4-inch scale matches President James Madison’s height.","source_url":"https://www.jmu.edu/admissions/explore/spirit-traditions.shtml","source_title":"Spirit and Traditions - JMU","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Outdoor landmark near the Quad; view it from established campus walkways.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"the-union-pool-tables","subject_type":"sequence_stop","entity_name":"The Union","title":"Play a Round at The Union","subtitle":"Friday evening · Warren Hall","notes":"Bring your JACard, find the student lounges, and use the free pool tables for an easy first-night activity with new classmates.","short_summary":"Turn Friday evening into a low-pressure game night.","evidence_claim":"The Union’s official page lists student lounges, a movie theater, and free pool tables among the building’s amenities.","source_url":"https://www.jmu.edu/ucenter/boxoffice","source_title":"The Union at James Madison University - JMU","source_kind":"university_official","source_published_at":"2026-01-28","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Use during posted building hours; some areas or after-hours entrances may require an active JACard.","cost_status":"free","under21_safe":true},{"subject_id":"harrisonburg-farmers-market-saturday","subject_type":"sequence_stop","entity_name":"Harrisonburg Farmers Market","title":"Browse the Saturday Market","subtitle":"Saturday morning · Turner Pavilion downtown","notes":"Walk the producer-only stalls, compare seasonal goods, and treat buying breakfast or crafts as optional rather than assumed.","short_summary":"Start Saturday among regional growers, makers, and prepared-food vendors.","evidence_claim":"The market’s official site identifies it as a producer-only market at 228 South Liberty Street and lists Saturday sessions year-round.","source_url":"https://www.harrisonburgfarmersmarket.com/","source_title":"Harrisonburg Farmers Market","source_kind":"business_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Saturday hours vary by season: the official site lists 8 a.m.–1 p.m. April–November and 9 a.m.–1 p.m. December–March.","cost_status":"unknown","under21_safe":true},{"subject_id":"edith-carrier-arboretum-pond-loop","subject_type":"sequence_stop","entity_name":"Edith J. Carrier Arboretum","title":"Circle Plecker Pond","subtitle":"Saturday late morning · University Boulevard","notes":"Enter from Lot R5 or the welcome center, follow the accessible pond loop, and leave plants, wildlife, and water features undisturbed.","short_summary":"Trade downtown pavement for an accessible garden-and-pond loop.","evidence_claim":"JMU states that the arboretum grounds are free to the public from dawn to dusk daily and describes Plecker Pond Loop as fully accessible.","source_url":"https://www.jmu.edu/arboretum/visit/index.shtml","source_title":"Visit the Arboretum - JMU","source_kind":"university_official","source_published_at":"2026-07-29","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Grounds are open dawn to dusk, 365 days a year; stay on appropriate paths and follow the posted preserve guidelines.","cost_status":"free","under21_safe":true},{"subject_id":"jmu-trail-loops-one-mile","subject_type":"sequence_stop","entity_name":"JMU Trail Loops","title":"Try the One-Mile Trail Loop","subtitle":"Saturday midday · UREC-to-Arboretum trail system","notes":"Choose the marked one-mile loop, wear shoes for mixed surfaces, and skip longer sections if construction notices remain posted.","short_summary":"Add a short, clearly marked trail segment between campus destinations.","evidence_claim":"JMU Recreation documents one-, two-, and three-mile trail loops connecting UREC, the arboretum, and University Park, with varied surfaces and steep terrain in places.","source_url":"https://www.jmu.edu/recreation/sports/informal-recreation/running-jogging-walking.shtml","source_title":"Running, Jogging & Walking - JMU","source_kind":"university_official","source_published_at":"2026-03-17","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Check the official page for construction notices; trails include chipped wood, gravel, concrete, inclines, and declines.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"john-wells-planetarium-saturday-show","subject_type":"sequence_stop","entity_name":"John C. Wells Planetarium","title":"Catch a Saturday Sky Show","subtitle":"Saturday afternoon · Miller Hall","notes":"Check the current program, arrive before your chosen public show, and pair the full-dome movie with its accompanying star talk.","short_summary":"Spend Saturday afternoon under a full-dome simulated sky.","evidence_claim":"The planetarium’s official page says its Saturday public shows are free and lists family shows at 11 a.m. and 1 p.m. plus feature shows at 2:15 and 3:30 p.m.","source_url":"https://www.jmu.edu/planetarium/index.shtml","source_title":"Welcome to the John C. Wells Planetarium - JMU","source_kind":"university_official","source_published_at":"2026-06-20","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Verify the current calendar before going; closures, university breaks, delays, or special programming can affect shows.","cost_status":"free","under21_safe":true},{"subject_id":"university-recreation-center-first-visit","subject_type":"sequence_stop","entity_name":"University Recreation Center","title":"Learn Your Way Around UREC","subtitle":"Saturday late afternoon · Driver Drive","notes":"Swipe in with your JACard, tour the main activity areas, and choose a familiar first activity rather than committing to a full workout.","short_summary":"Make the large recreation center feel manageable on your first visit.","evidence_claim":"JMU’s UREC guide says students have a membership, enter with a JACard or the UREC app, and can use programs spanning aquatics, fitness, intramurals, and adventure activities.","source_url":"https://www.jmu.edu/recreation/visit/guide.shtml","source_title":"University Recreation (UREC) Guide - JMU","source_kind":"university_official","source_published_at":"2026-05-14","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Active student membership and JACard or app entry are required; confirm operating hours and facility availability before visiting.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"duke-dog-bronze-statue","subject_type":"sequence_stop","entity_name":"Duke Dog Statue","title":"Find the Bronze Duke Dog","subtitle":"Saturday evening · Near Bridgeforth Stadium","notes":"Follow public campus paths to the large bronze mascot, take a photo from the plaza, and leave event-controlled areas undisturbed.","short_summary":"Close Saturday with one of JMU’s largest mascot landmarks.","evidence_claim":"JMU documents the 2,100-pound bronze Duke Dog statue outside the Plecker Athletic Performance Center behind Bridgeforth Stadium’s south end zone.","source_url":"https://www.jmu.edu/centennialcelebration/statue.shtml","source_title":"JMU Centennial Celebration - Duke Dog Statue","source_kind":"university_official","source_published_at":"2023-09-13","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Outdoor viewing may be affected by athletic-event security, ticketing perimeters, or temporary venue restrictions.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"spirit-rock-east-campus","subject_type":"sequence_stop","entity_name":"Spirit Rock","title":"Read the Spirit Rock","subtitle":"Sunday · East Campus","notes":"Finish the weekend by viewing the rock’s current message; photograph it as found and respect nearby classes, events, and painters.","short_summary":"See how the campus message changes through layers of student expression.","evidence_claim":"JMU describes Spirit Rock as an East Campus canvas where campus artists paint event notices or inspirational messages over accumulated layers of paint.","source_url":"https://www.jmu.edu/admissions/explore/spirit-traditions.shtml","source_title":"Spirit and Traditions - JMU","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"View from public campus space; painting may be governed by current university rules, so check those rules before altering the rock.","cost_status":"not_applicable","under21_safe":true}],"warnings":[]}],"warnings":[]}
