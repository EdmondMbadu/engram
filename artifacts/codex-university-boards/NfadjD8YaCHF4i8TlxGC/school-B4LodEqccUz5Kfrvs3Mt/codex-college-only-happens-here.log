ittee.","cost_status":"unknown","under21_safe":true},{"subject_id":"pomona-sponsor-groups","subject_type":"tradition","entity_name":"Sponsor groups","title":"Sponsor Groups","subtitle":"New Student Orientation, Pomona College","notes":"Meet your assigned sponsor group early, use it for orientation questions and join its Walker Wall painting activity.","short_summary":"Small residence-hall cohorts connect new students with returning student sponsors.","evidence_claim":"Pomona says incoming students are assigned to sponsor groups of 10–20 hallmates led by older students who live among them and provide guidance.","source_url":"https://www.pomona.edu/about/traditions","source_title":"Traditions at Pomona College","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Assigned before new students arrive; use official orientation communications for current details.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"pomona-through-the-gates","subject_type":"tradition","entity_name":"Through the Gates","title":"Through the Gates","subtitle":"College Gates, Pomona College","notes":"Enter through the gates during New Student Orientation, then return for the outward walk during Commencement weekend.","short_summary":"Students ceremonially enter at orientation and leave through the same gates before commencement.","evidence_claim":"Pomona says new students enter through the College Gates at orientation and, four years later, march through them in the other direction before Commencement.","source_url":"https://www.pomona.edu/about/traditions","source_title":"Traditions at Pomona College","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Orientation and pre-Commencement tradition; participate through the College’s scheduled ceremonies.","cost_status"