sed.","cost_status":"free","under21_safe":true},{"subject_id":"csusb-student-success-studio","subject_type":"study_space","entity_name":"Student Success Studio (S3)","title":"Work Without a Reservation at S3","subtitle":"Independent and group study space in Indian Wells 202/203","notes":"Drop in for solo or group work without reserving a room, and use the computers, academic software or microwave when needed.","short_summary":"A no-reservation academic workspace with technology, tutoring support and practical amenities.","evidence_claim":"CSUSB says S3 provides group and independent study space without reservations, plus computers, academic software, internet and microwave access.","source_url":"https://www.csusb.edu/student-success-studio","source_title":"Student Success Studio (S3) | CSUSB","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Located in Indian Wells 202/203. Summer 2026 hours are Monday–Thursday, 7:00 a.m.–5:30 p.m.; Friday–Sunday closed.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"csusb-smsu-social-stairs","subject_type":"study_space","entity_name":"SMSU North Social Stairs","title":"Use the Social Stairs Between Classes","subtitle":"Tiered seating inside Santos Manuel Student Union North","notes":"Choose a step for a short study block or a relaxed meet-up, while keeping the stair route clear for people moving through the union.","short_summary":"A recognizable student-union feature used for both informal studying and time with friends.","evidence_claim":"CSUSB’s SMSU employee handbook states that students can study and relax with friends on the Social Stairs in SMSU North.","source_url":"https://www.csusb.edu/sites/default/files/upload/file/2025/SMSU%20and%20SRWC%20Student%20Employee%20Handbook%205.1.25_0.pdf","source_title":"SMSU and SRWC Student Employee Handbook","source_kind":"university_official","source_publis