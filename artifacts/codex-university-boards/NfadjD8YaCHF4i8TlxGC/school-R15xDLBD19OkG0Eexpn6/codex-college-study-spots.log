l device.","source_url":"https://www.csusb.edu/library/services/reserve-study-rooms","source_title":"Reserve Study Rooms | John M. Pfau Library | CSUSB","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"These are group rooms for two or more people. Reserve with a MyCoyote account up to one week ahead and arrive within ten minutes of the booked start.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"csusb-individual-study-rooms","subject_type":"study_space","entity_name":"Pfau Library Individual Study Rooms","title":"Reserve a Room for Solo Focus","subtitle":"Ten reservable individual study rooms on the fourth floor","notes":"Schedule a private work block up to one week ahead, save the confirmation email, and arrive promptly so the reservation is not forfeited.","short_summary":"Reservable fourth-floor rooms intended for one-person study sessions.","evidence_claim":"Pfau Library states that ten individual study rooms on the fourth floor can be reserved in advance and identifies the individual room type as seating one person.","source_url":"https://www.csusb.edu/library/services/reserve-study-rooms","source_title":"Reserve Study Rooms | John M. Pfau Library | CSUSB","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"For one person only. Reserve with a MyCoyote login for up to four half-hour slots, as far as one week ahead, and retain the confirmation email.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"csusb-gel-lab-rooms","subject_type":"study_space","entity_name":"Geospatial Engagement and Learning Lab Rooms","title":"Run Mapping Work in a GEL Lab Room","subtitle":"Four reservable rooms for geospatial projects","notes":"Reserve a GEL room when coursework calls for ArcGIS or spatial analysis, and plan for no more than two people at its high-performance computer.","short_summary":"Small reservable rooms equipped for mapping and spatial-analysis assignments.","evidence_claim":"Pfau Library says four Geospatial Engagement and Learning Lab study rooms seat two people and provide high-performance computers with ArcGIS and other spatial-mapping software.","source_url":"https://www.csusb.edu/library/services/reserve-study-rooms","source_title":"Reserve Study Rooms | John M. Pfau Library | CSUSB","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Each room seats two. Reserve through the library system with a MyCoyote login, keep the confirmation email, and arrive within ten minutes.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"csusb-pl-503-multi-group-room","subject_type":"study_space","entity_name":"Multi-Group Study Room PL-503","title":"Share a Table in PL-503","subtitle":"A non-reservable fifth-floor room for multiple groups","notes":"Try PL-503 when advance booking is not practical, choose an open table, and arrive prepared to share the room with other working groups.","short_summary":"A shared group-study room available without advance reservations.","evidence_claim":"Pfau Library identifies PL-503 as a Multi-Group Study Room with several tables, says it cannot be reserved, and requires groups to share while a table remains unoccupied.","source_url":"https://www.csusb.edu/library/services/reserve-study-rooms","source_title":"Reserve Study Rooms | John M. Pfau Library | CSUSB","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"No advance reservation is available. Use is subject to Pfau Library building hours, and occupants must share the room while an unoccupied table is available.","cost_status":"not_applicable","under21_safe":true}],