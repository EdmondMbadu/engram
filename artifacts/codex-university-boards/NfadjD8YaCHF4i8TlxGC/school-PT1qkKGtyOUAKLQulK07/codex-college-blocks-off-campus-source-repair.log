anyourvisit/capital-crescent-trail.htm","source_title":"Capital Crescent Trail","source_kind":"government","source_published_at":"2025-07-04","source_fetched_at":"2026-08-13","latitude":38.904414,"longitude":-77.070255,"maps_url":null,"access_notes":"A local detour may be in place near the Potomac Aqueduct; consult current park conditions.","cost_status":"unknown","under21_safe":true},{"subject_id":"tudor-place-31st-street-nw","subject_type":"street_or_district","entity_name":"Tudor Place Historic House & Garden","title":"31st Street NW: Tudor Place","subtitle":"31st Street NW corridor","notes":"Plan a garden visit or guided house tour at this National Historic Landmark, and reserve ahead if your group is large.","short_summary":"Historic house and garden on 31st Street.","evidence_claim":"Tudor Place identifies its site at 1644 31st Street NW as a National Historic Landmark with a historic house museum and five-and-a-half acres of garden.","source_url":"https://tudorplace.org/visit/","source_title":"Visit Tudor Place","source_kind":"cultural_institution","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Guided house tours and garden access follow Tudor Place’s current visitor schedule; a suggested donation is listed.","cost_status":"unknown","under21_safe":true},{"subject_id":"dumbarton-house-q-street-nw","subject_type":"street_or_district","entity_name":"Dumbarton House","title":"Q Street NW: Dumbarton House","subtitle":"Q Street NW corridor","notes":"Find the Federal-period house at 2715 Q Street, then check the museum’s visit page before making the walk for entry.","short_summary":"A historic house museum on Q Street.","evidence_claim":"Dumbarton House identifies its historic house museum at 2715 Q Street NW in Washington, DC.","source_url":"https://dumbartonhouse.org/visit-dumbarton-house/","source_title":"Visit Dumbarton House","source_kind":"cultural_institution","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The museum currently states that it is closed for an HVAC overhaul; confirm reopening information before visiting.","cost_status":"unknown","under21_safe":true},{"subject_id":"georgetown-library-r-street-nw","subject_type":"street_or_district","entity_name":"Georgetown Library","title":"R Street NW: Georgetown Library","subtitle":"R Street NW corridor","notes":"Bring a book or research question to the library’s reading and study spaces, including its Georgetown-history Peabody Room.","short_summary":"A public library with Georgetown history resources.","evidence_claim":"DC Public Library lists Georgetown Library at 3260 R Street NW and identifies the Peabody Room as a special collection of Georgetown neighborhood history.","source_url":"https://www.dclibrary.org/plan-visit/georgetown-library","source_title":"Georgetown Library","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Use current branch hours and library visitor rules; the page lists study rooms, computers, printing, and Wi-Fi.","cost_status":"unknown","under21_safe":true},{"subject_id":"book-hill-park-wisconsin-avenue-nw","subject_type":"street_or_district","entity_name":"Book Hill Park","title":"Wisconsin Avenue NW: Book Hill Park","subtitle":"Wisconsin Avenue NW corridor","notes":"Step off Wisconsin Avenue at Reservoir Road to see the hilltop park, and use its stairs and public seating areas respectfully.","short_summary":"A small public park at Wisconsin and Reservoir.","evidence_claim":"DC’s Department of General Services locates Book Hill Park at Wisconsin Avenue NW and Reservoir Road NW and documents planned stair, bench, lighting, and seating improvements.","source_url":"https://dgs.dc.gov/page/book-hill-park-improvements","source_title":"Book Hill Park Improvements","source_kind":"government","sou