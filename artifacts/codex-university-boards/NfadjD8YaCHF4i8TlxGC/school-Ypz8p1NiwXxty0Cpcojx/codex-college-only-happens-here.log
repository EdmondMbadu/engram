er.org/wp-content/uploads/2022/04/vol-17-issue-1.pdf","source_title":"The Muddraker, Volume 17 Issue 1","source_kind":"student_media","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Do not ride in pedestrian traffic; follow current campus transportation and safety rules.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"hmc-atwood-hochsgiving","subject_type":"tradition","entity_name":"Atwood Hochsgiving","title":"Recognize Atwood’s Hochsgiving","subtitle":"Atwood Dorm and Hoch-Shanahan Dining Commons","notes":"If the dorm announces a current gathering, join through its organizers and use the microphone moment to share a short expression of gratitude.","short_summary":"A dorm holiday gathering with a gratitude-sharing ritual.","evidence_claim":"The Muddraker reported that Atwood's holiday activities began with a dorm-wide Hochsgiving dinner, ending with residents sharing what they were thankful for.","source_url":"https://themuddraker.org/wp-content/uploads/2020/08/muddrakerdecember2018.pdf","source_title":"The Muddraker: Holiday Traditions","source_kind":"student_media","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Historical documentation from 2018; confirm that the dorm still holds it before planning around it.","cost_status":"unknown","under21_safe":true},{"subject_id":"hmc-north-one-song-wednesday","subject_type":"tradition","entity_name":"One Song Wednesday","title":"Know the North Dorm speaker-suite custom","subtitle":"North Dorm speaker suite","notes":"Treat this as dorm history rather than a cue to amplify music: ask North residents whether any current, quiet version is officially scheduled.","short_summary":"A North Dorm speaker-suite tradition documented by student media.","evidence_claim":"The Muddraker described North Dorm’s long-held “One Song Wednesday” tradition and its speaker-suite context.","source_url":"https://themuddraker.org/wp-content/uploads/2020/08/dec2017.pdf","source_title":"The Muddraker: Mudd’s Music: Speaker Suites","source_kind":"student_media","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Historical documentation from 2017; respect residence-hall quiet hours and confirm any current practice with residents.","cost_status":"not_applicable","under21_safe":true}],"warnings":["Several dorm-specific and historic traditions are documented by older student-media sources; cards explicitly direct users to confirm present-day occurrence."]}],"warnings":[]}
