"source_url":"https://www.flsouthern.edu/campus-offices/offices-directory/office-of-wellness/waterfront","source_title":"Waterfront","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Open Friday through Sunday during the academic year and closed during the posted summer period. FSC ID, waiver, lifejacket, and attendant compliance are required.","cost_status":"free","under21_safe":true},{"subject_id":"fsc-intramural-fields","subject_type":"place","entity_name":"Intramural Fields","title":"Bring a Group to the Intramural Fields","subtitle":"Callahan Court fields used for Ultimate Frisbee and flag football","notes":"Check programming or field availability before organizing a game, then borrow eligible sports equipment from the Wellness Center if needed.","short_summary":"Outdoor fields give informal groups and intramural programs room for field sports.","evidence_claim":"Florida Southern identifies its Intramural Fields on Callahan Court as spaces used for sports including Ultimate Frisbee and flag football.","source_url":"https://www.flsouthern.edu/campus-life/wellness-and-recreation","source_title":"Wellness and Recreation","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Field availability may be affected by intramural schedules, reservations, weather, and campus operations; verify before planning a group game.","cost_status":"unknown","under21_safe":true},{"subject_id":"fsc-sand-volleyball-courts","subject_type":"place","entity_name":"Sand Volleyball Courts","title":"Set Up a Sand-Volleyball Break","subtitle":"Courts on Columbia Street across from Wynee’s Bistro","notes":"Gather enough players, check whether the courts are scheduled, and ask the Wellness Center about borrowing a volleyball before heading over.","short_summary":"A named outdoor court area suited to a quick pickup game between other campus commitments.","evidence_claim":"Florida Southern states that it maintains sand volleyball courts on Columbia Street across from Wynee’s Bistro and offers sports-equipment checkout.","source_url":"https://www.flsouthern.edu/campus-life/wellness-and-recreation","source_title":"Wellness and Recreation","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Confirm court availability and equipment-checkout requirements with the Wellness Center; organized programming may take priority.","cost_status":"unknown","under21_safe":true},{"subject_id":"fsc-agb-museum-of-art","subject_type":"place","entity_name":"Ashley Gibson Barnett Museum of Art","title":"Use the Museum for an Art Reset","subtitle":"A Florida Southern cultural center two blocks north of campus","notes":"Check the current exhibitions before leaving campus, then use a short gallery visit as a visual break or starting point for creative coursework.","short_summary":"A campus-adjacent museum gives students a documented, no-admission-cost place to engage with changing exhibitions.","evidence_claim":"Florida Southern’s October 2025 parent newsletter states that the campus-adjacent Ashley Gibson Barnett Museum of Art provides free admission to all, including students.","source_url":"https://www.flsouthern.edu/getattachment/9fefded4-9f6c-48c8-87cb-60a6f7ece7ec/October-2025-Parents-Newsletter.pdf?ext=.pdf&lang=en-US","source_title":"October 2025 Parents Newsletter","source_kind":"university_official","source_published_at":"2025-10-01","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Located two blocks north of the College. Check the museum’s current opening schedule and exhibition notices before visiting.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
