l,"maps_url":"https://www.google.com/maps/search/?api=1&query=Louis+Murphy+Park%2C+1700+S+Grandview+Avenue%2C+Dubuque%2C+IA","access_notes":"Ordinary park access requires no admission or purchase. Use open picnic areas rather than any pavilion reserved for a private group.","cost_status":"free","under21_safe":true},{"subject_id":"veterans-memorial-plaza-art-walk","subject_type":"activity","entity_name":"Veterans Memorial Plaza","title":"Walk the Memorial Boardwalk","subtitle":"Veterans Memorial Plaza at McAleece Park","notes":"Follow the swirling path onto the pond boardwalk, then view the Skyward sculpture and granite globe.","short_summary":"A reflective public-art walk through Dubuque's veterans memorial complex.","evidence_claim":"The City documents the plaza's granite globe and a decorative path leading to an elevated pond boardwalk and the Skyward sculpture; admission to city parks is free.","source_url":"https://www.cityofdubuque.org/2611","source_title":"Veterans Memorial Plaza","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":"https://www.google.com/maps/search/?api=1&query=Veterans+Memorial+Plaza%2C+1801+Admiral+Sheehy+Drive%2C+Dubuque%2C+IA","access_notes":"The plaza is a public city-park feature with no admission or required purchase. Treat memorial elements respectfully and remain on designated paths.","cost_status":"free","under21_safe":true},{"subject_id":"veterans-memorial-park-inclusive-play","subject_type":"activity","entity_name":"Miracle League of Dubuque Complex","title":"Meet at the Inclusive Playground","subtitle":"Veterans Memorial Park and Miracle League","notes":"Gather at the all-inclusive playground for accessible outdoor recreation designed for children and adults of varied abilities.","short_summary":"An accessible, no-admission recreation stop for an all-ages group.","evidence_claim":"The City's facility page says the Miracle League complex at Veterans Memorial Park offers an all-inclusive playground and baseball field for children and adults of all abilities.","source_url":"https://www.cityofdubuque.org/2934/Location-Amenities","source_title":"Location & Amenities","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":"https://www.google.com/maps/search/?api=1&query=Miracle+League+of+Dubuque%2C+2790+Miracle+League+Drive%2C+Dubuque%2C+IA","access_notes":"The complex is open daily from 7 a.m.–10 p.m. Ordinary playground access requires no admission or purchase; organized field use may be scheduled.","cost_status":"free","under21_safe":true},{"subject_id":"carnegie-stout-library-wifi-session","subject_type":"activity","entity_name":"Carnegie-Stout Public Library","title":"Host a Free Wi-Fi Work Session","subtitle":"Carnegie-Stout Public Library","notes":"Bring charged devices, connect to the public Wi-Fi, and work side by side without buying drinks or obtaining a guest card.","short_summary":"A free indoor study meetup with public internet access.","evidence_claim":"The library's official FAQ states that free wireless internet is available to the public throughout the building and immediately outside it.","source_url":"https://carnegiestout.org/ufaqs/page/2/","source_title":"FAQs Archive – Carnegie-Stout Public Library","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":"https://www.google.com/maps/search/?api=1&query=Carnegie-Stout+Public+Library%2C+360+W+11th+Street%2C+Dubuque%2C+IA","access_notes":"Public Wi-Fi needs no purchase. Current listed hours are Monday–Thursday 9 a.m.–7 p.m., Friday–Saturday 9 a.m.–5 p.m., and Sunday noon–5 p.m.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
