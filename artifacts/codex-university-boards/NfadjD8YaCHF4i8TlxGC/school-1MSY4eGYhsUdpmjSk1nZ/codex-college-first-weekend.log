western.edu/txt/facility/330","source_title":"Shakespeare Garden","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The garden is free and open to the public; use established paths and respect plantings.","cost_status":"free","under21_safe":true},{"subject_id":"northwestern-dearborn-observatory","subject_type":"sequence_stop","entity_name":"Dearborn Observatory","title":"Plan a Friday stargazing stop","subtitle":"Dearborn Observatory, Evanston campus","notes":"If your weekend includes Friday, check tour availability early; arrive ready for stairs and weather, then join the listed walk-in observing session.","short_summary":"A free public observing stop for a Friday-night campus visit.","evidence_claim":"Northwestern offers free public Friday-night tours at Dearborn Observatory, with a walk-in session at 10–11 PM from April through September.","source_url":"https://physics.northwestern.edu/about/dearborn-observatory/","source_title":"Dearborn Observatory","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Current April–September walk-in tours are Fridays, 10–11 PM; the observatory is not ADA accessible because the dome requires multiple staircases.","cost_status":"free","under21_safe":true},{"subject_id":"northwestern-nexus-gaming-lounge","subject_type":"activity","entity_name":"Nexus Gaming Lounge","title":"Close with a campus game session","subtitle":"Norris University Center Game Room","notes":"For a low-key indoor finish, bring your NetID and check station availability; weekly esports practices can limit general-use computers on some evenings.","short_summary":"A student-only, computer-gaming option inside Norris.","evidence_claim":"Northwestern says Nexus Gaming Lounge is free for Northwestern students, requires a university NetID, and has a ten-hour weekly usage limit.","source_url":"https://www.northwestern.edu/norris/programs-and-recreation/game-room/nexus-gaming-lounge.html","source_title":"Nexus Gaming Lounge","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Northwestern students need a NetID; Wednesday and Thursday esports activity can reduce general station availability.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
