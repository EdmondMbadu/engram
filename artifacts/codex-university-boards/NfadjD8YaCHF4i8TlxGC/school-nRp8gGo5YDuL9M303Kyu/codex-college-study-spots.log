lery","subtitle":"Bird Library Room 610, sixth floor","notes":"Work quietly among Special Collections displays when the sixth floor is open; the room pairs a small study setting with materials from the Plastics Collection.","short_summary":"A quiet study room that also displays materials from Special Collections' Plastics Collection.","evidence_claim":"The Libraries identifies Room 610 as a quiet study room on Bird Library's sixth floor that features materials from the Special Collections Plastics Collection.","source_url":"https://library.syracuse.edu/spaces/plastics-pioneers-reading-room-gallery/","source_title":"Plastics Pioneers Reading Room Gallery","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Available when the sixth floor is open; quiet-area guidance asks users to refrain from conversations.","cost_status":"unknown","under21_safe":true},{"subject_id":"syracuse-sensory-friendly-study-rooms","subject_type":"study_space","entity_name":"Sensory Friendly, Reservable, Individual Study Rooms","title":"Sensory Friendly, Reservable, Individual Study Rooms","subtitle":"Bird Library, third and fourth floors","notes":"Reserve an individual room when you want controllable lighting and sensory tools, or request one of the two first-come rooms at the first-floor Check Out desk.","short_summary":"Individual academic rooms equipped with dimmable lighting, sensory discs, and fidget items.","evidence_claim":"The Libraries says eight sensory-friendly individual rooms are reservable and two are first-come, with dimmable lighting, sensory discs, and fidget items.","source_url":"https://library.syracuse.edu/spaces/sensory-friendly-reservable-individual-study-rooms-bird-library/","source_title":"Sensory Friendly, Reservable, Individual Study Rooms, Bird Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":n