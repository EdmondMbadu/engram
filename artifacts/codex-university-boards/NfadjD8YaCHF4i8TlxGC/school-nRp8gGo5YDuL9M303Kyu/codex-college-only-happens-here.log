":"2025-07-29","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Listen from public outdoor areas; tower access is not part of this activity.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"syracuse-goon-squad-move-in","subject_type":"tradition","entity_name":"Goon Squad","title":"Meet the Goon Squad at Move-In","subtitle":"Welcome Week move-in tradition","notes":"During move-in, watch for the Goon Squad’s cheers and volunteer help as new students settle into residence halls.","short_summary":"An 80-year welcoming committee helps new students begin campus life.","evidence_claim":"Syracuse University identifies the Goon Squad as its official welcoming committee and says it has helped new students on move-in day since 1944.","source_url":"https://www.syracuse.edu/stories/goon-squad-traditions/","source_title":"Goon Squad Traditions Make Lasting Impact","source_kind":"university_official","source_published_at":"2024-08-20","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"This tradition occurs during University move-in programming; follow residence-hall check-in instructions.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"syracuse-national-orange-day","subject_type":"tradition","entity_name":"National Orange Day","title":"Mark National Orange Day","subtitle":"March 24 founding-anniversary tradition","notes":"Wear orange or join a listed service activity on March 24, Syracuse University’s annual founding-anniversary celebration.","short_summary":"The University’s anniversary is observed with orange gear, service and campus events.","evidence_claim":"The University says National Orange Day is held March 24, its 1870 founding anniversary, with orange gear, service activities and events.","source_url":"https://www.syracuse.edu/stories/celebrated-syracuse-university-traditions/","source_title":"Celebrated Syracuse University Traditions","source_kind":"university_official","source_published_at":"2025-07-29","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Check the University events calendar for that year’s public National Orange Day activities.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"syracuse-kissing-bench","subject_type":"tradition","entity_name":"Kissing Bench","title":"Find the Kissing Bench","subtitle":"Between Hall of Languages and Tolley Humanities Building","notes":"Visit the Class of 1912 stone bench and learn the campus saying that couples who sit together are destined to wed.","short_summary":"A stone bench carries a playful Syracuse relationship legend.","evidence_claim":"The University describes the Kissing Bench as a Class of 1912 gift and records the tradition that couples who sit there are destined to wed.","source_url":"https://www.syracuse.edu/stories/celebrated-syracuse-university-traditions/","source_title":"Celebrated Syracuse University Traditions","source_kind":"university_official","source_published_at":"2025-07-29","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Located outdoors on the west side of Hall of Languages; respect other visitors’ space.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"syracuse-diana-dog-paw","subject_type":"tradition","entity_name":"Diana the Huntress Dog Paw","title":"Rub the Dog’s Paw for Luck","subtitle":"Carnegie Library exam ritual","notes":"Before an exam or important moment, visit Diana the Huntress at Carnegie Library and offer a good wish while rubbing the dog’s paw.","short_summary":"Students pair an art landmark with a small pre-exam good-luck ritual.","evidence_claim":"The University says tradition holds that rubbing the dog’s paw on Diana the Huntress while offering a good wish invites exam success.","source_url":"https://www.syracuse.edu/stories/celebrated-syracuse-university-traditions/","source_title":"Celebrated Syracuse University Traditions","source_kind":"university_official","source_published_at":"2025-07-29","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The statue is at Carnegie Library; use public building access and avoid obstructing others.","cost_status":"not_applicable","under21_safe":true}],"warnings":[]}],"warnings":[]}
