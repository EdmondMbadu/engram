ridges.org/faq","source_title":"Crystal Bridges FAQ","source_kind":"cultural_institution","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Permanent collection galleries are free; special temporary exhibitions may charge admission. Check museum hours and exhibition details before traveling.","cost_status":"free","under21_safe":true}],"warnings":["The Botanical Garden free-admission option is restricted to Fayetteville residents on Saturdays from 9 a.m. to noon. Crystal Bridges is in Bentonville, not Fayetteville."]}],"warnings":[]}
