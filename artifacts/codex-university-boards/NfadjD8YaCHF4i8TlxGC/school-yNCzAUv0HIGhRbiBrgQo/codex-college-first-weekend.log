ntity_name":"The Arboretum at Penn State","title":"Saturday morning — Walk the Arboretum","subtitle":"East Park Avenue and Bigler Road, University Park","notes":"Follow the accessible major walkways through the botanic gardens and bring water; stay on paths and plan to finish before dusk.","short_summary":"A free, self-guided outdoor walk through Penn State’s living plant collections.","evidence_claim":"The Arboretum states that it is open daily from dawn to dusk and that there is no admission charge for the H.O. Smith Botanic Gardens or Arboretum land beyond the gardens.","source_url":"https://arboretum.psu.edu/visit/visitor-information/","source_title":"Hours, Admission, Directions, Parking - The Arboretum at Penn State","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Open daily dawn to dusk; Penn State notes that all major walkways are accessible.","cost_status":"free","under21_safe":true},{"subject_id":"psu-palmer-museum","subject_type":"sequence_stop","entity_name":"Palmer Museum of Art","title":"Saturday midday — Enter the Palmer Museum of Art","subtitle":"University Park campus museum","notes":"Reserve a free timed-entry ticket if available, then move through the galleries at your own pace and check museum guidance before taking photos.","short_summary":"A free campus museum visit with timed entry encouraged by the museum.","evidence_claim":"The Palmer Museum of Art states that admission is always free and encourages visitors to reserve a free timed-entry ticket to guarantee entrance.","source_url":"https://palmermuseum.psu.edu/wp-content/uploads/2021/06/Know-Before-You-Go-PDF-download_UPDATED-2021.06.30.pdf","source_title":"Know Before You Go","source_kind":"cultural_institution","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Admission is free; the museum encourages a free timed-entry reservation. Confirm current gallery hours and ticketing before leaving.","cost_status":"free","under21_safe":true},{"subject_id":"psu-pattee-paterno-library","subject_type":"sequence_stop","entity_name":"Pattee/Paterno Library Computer Labs","title":"Saturday afternoon — Settle into Pattee/Paterno","subtitle":"Pattee/Paterno Library, University Park","notes":"Use the library’s public computer labs or printers to handle one practical task, such as checking course systems or organizing your upcoming week.","short_summary":"A practical campus-resource stop with publicly listed computer-lab hours.","evidence_claim":"Penn State IT lists two computer labs, hallway stations, and printers at Pattee/Paterno Library and publishes University Park operating hours for the location.","source_url":"https://www.it.psu.edu/labs/locations/","source_title":"Computer Lab Locations | Information Technology","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Penn State IT lists hours for the Pattee/Paterno location; verify the current schedule before visiting, especially between terms.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"psu-sensory-friendly-libraries","subject_type":"sequence_stop","entity_name":"Sensory-Friendly Libraries Rooms W023 and W027","title":"Saturday afternoon — Locate a quiet reset space","subtitle":"Collaboration Commons, West Pattee Library","notes":"If a quieter pause would help, locate the two sensory rooms in West Pattee; they are not reservable, so use them considerately and share the space.","short_summary":"Two named, walk-in sensory rooms intended for quiet comfort and focused activity.","evidence_claim":"Penn State’s Sensory-Friendly Libraries site says rooms W023 and W027 are on the ground floor of West Pattee Library, are not reservable, and are open to anyone who wants to use them.","source_url":"https://sites.psu.edu/sensoryfriendlylibraries/university-park/","source_title":"Sensory-Friendly Libraries: University Park","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Rooms W023 and W027 are not reservable and are open to anyone; treat them as shared quiet spaces.","cost_status":"free","under21_safe":true},{"subject_id":"psu-beaver-stadium","subject_type":"sequence_stop","entity_name":"Beaver Stadium","title":"Sunday morning — Walk by Beaver Stadium","subtitle":"East side of the University Park campus","notes":"Use the stadium exterior as the final landmark on your loop, and check campus notices before approaching because revitalization work is ongoing.","short_summary":"A historic campus stadium whose exterior can anchor an east-campus walk.","evidence_claim":"Penn State documents that Beaver Stadium was moved and reassembled on the east side of the University Park campus in 1960; current university reporting says revitalization construction began after the 2024 season.","source_url":"https://www.psu.edu/news/intercollegiate-athletics/story/intercollegiate-athletics-unveils-details-beaver-stadium","source_title":"Intercollegiate Athletics unveils details on Beaver Stadium Revitalization","source_kind":"university_official","source_published_at":"2025-02-17","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"View from public exterior areas only. Penn State reports active revitalization work; obey barriers, event controls, and posted access limits.","cost_status":"not_applicable","under21_safe":true}],"warnings":[]}],"warnings":[]}
