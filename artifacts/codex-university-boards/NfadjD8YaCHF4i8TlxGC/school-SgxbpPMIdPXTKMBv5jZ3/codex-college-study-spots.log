ct tasks.","short_summary":"First-floor open study area equipped with computers, scanners, and printers.","evidence_claim":"The first-floor Knight Library Learning Commons is an open area with Macintosh and PC computers, scanners, black-and-white printers, color printers, and outlets.","source_url":"https://library.uoregon.edu/rooms-study-spaces/knight-library-learning-commons","source_title":"Knight Library Learning Commons | UO Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Open-area space; the official page lists equipment but no reservation requirement.","cost_status":"unknown","under21_safe":true},{"subject_id":"knight-cinema-studies-lab","subject_type":"study_space","entity_name":"Knight Library Cinema Studies Classroom Lab","title":"Use the Cinema Studies Lab","subtitle":"Knight Library 267, second floor","notes":"Check the term schedule at the door and arrange required training before first use; plan computer-based work around instructional priority.","short_summary":"A computer classroom lab that keeps open hours for the UO community.","evidence_claim":"Knight Library's Cinema Studies Classroom Lab has open hours for UO students, faculty, and staff during most evenings and weekends, while weekdays prioritize academic instruction.","source_url":"https://library.uoregon.edu/rooms-study-spaces/knight-library-cinema-studies-classroom-lab","source_title":"Knight Library Cinema Studies Classroom Lab | UO Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"First-time users must schedule training; the term-specific open schedule is posted at the lab door, and Cinema Studies classes have weekday priority.","cost_status":"unknown","under21_safe":true},{"subject_id":"knight-abc-study-room","subject_type":"study_space","entity_n