om casual sightseeing.","short_summary":"A named county civic destination on the downtown San Francisco Street corridor.","evidence_claim":"Coconino County states that all court divisions are in the Coconino County Courthouse at 200 North San Francisco Street, Flagstaff.","source_url":"https://www.coconino.az.gov/DocumentCenter/View/1855","source_title":"Coconino County — Finishing a Case","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"This is an operating courthouse; follow posted security and public-access requirements.","cost_status":"not_applicable","under21_safe":true}],"warnings":[]}],"warnings":[]}
