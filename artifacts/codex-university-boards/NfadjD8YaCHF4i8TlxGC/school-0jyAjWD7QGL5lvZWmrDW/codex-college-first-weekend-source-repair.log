icies.","cost_status":"free","under21_safe":true},{"subject_id":"museum-of-northern-arizona","subject_type":"sequence_stop","entity_name":"Museum of Northern Arizona","title":"Spend time with northern Arizona history","subtitle":"Saturday afternoon · Fort Valley Road","notes":"Browse the museum’s current exhibitions and public programs for regional art, science, and cultural history; reserve extra time if a program is scheduled.","short_summary":"A regional museum visit focused on the Colorado Plateau.","evidence_claim":"The Museum of Northern Arizona presents exhibitions and programs about the Colorado Plateau’s cultural and natural heritage.","source_url":"https://musnaz.org/","source_title":"Museum of Northern Arizona","source_kind":"cultural_institution","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":35.235833,"longitude":-111.664167,"maps_url":null,"access_notes":"Confirm current visitor hours, ticketing, and exhibition availability directly with the museum.","cost_status":"purchase_required","under21_safe":true},{"subject_id":"lowell-observatory","subject_type":"sequence_stop","entity_name":"Lowell Observatory","title":"Plan an evening at Lowell Observatory","subtitle":"Saturday night · Mars Hill","notes":"Select a current public program or observing session from Lowell’s schedule, arrive with time for check-in, and dress for Flagstaff’s evening weather.","short_summary":"An astronomy-focused evening program in Flagstaff.","evidence_claim":"Lowell Observatory offers public visitor experiences, programs, and telescope viewing opportunities.","source_url":"https://lowell.edu/visit/","source_title":"Lowell Observatory: Visit","source_kind":"cultural_institution","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":35.202878,"longitude":-111.664728,"maps_url":null,"access_notes":"Reserve or purchase as required through the observatory’s current visitor schedule; program availability varies.","cost_status":"purchase_require