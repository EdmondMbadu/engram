ersity-provided equipment.","evidence_claim":"Stockton lists ping pong among the recreational games the Campus Center Game Room offers the Stockton community to play for free.","source_url":"https://stockton.edu/campus-center/operations/services.html","source_title":"Game Room & Coffee House","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"For the Stockton University community; a Stockton ID is required to borrow Game Room equipment. Check current conditions during breaks or summer.","cost_status":"free","under21_safe":true},{"subject_id":"stockton-game-room-foosball","subject_type":"activity","entity_name":"Campus Center Game Room Foosball","title":"Start a foosball match","subtitle":"Campus Center Coffee House & Game Room","notes":"Gather two or four players, borrow the equipment with a Stockton ID, and play a short round before heading to your next campus stop.","short_summary":"A free foosball game in the Campus Center.","evidence_claim":"Stockton lists foosball among the recreational games the Campus Center Game Room offers the Stockton community to play for free.","source_url":"https://stockton.edu/campus-center/operations/services.html","source_title":"Game Room & Coffee House","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"For the Stockton University community; a Stockton ID is required to borrow Game Room equipment. Game Room hours vary outside the academic semester.","cost_status":"free","under21_safe":true},{"subject_id":"stockton-game-room-board-games","subject_type":"activity","entity_name":"Campus Center Game Room Board Games","title":"Choose a board game together","subtitle":"Campus Center Coffee House & Game Room","notes":"Use a Stockton ID to borrow a board game and claim a nearby table for a slower hang. Return borrowed equip