ices/9-botanic-garden-passes","source_title":"Fort Worth Botanic Garden Passes | City of Fort Worth","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Requires an available Fort Worth Public Library pass and compliance with its loan rules; excludes special events and programs.","cost_status":"free","under21_safe":true},{"subject_id":"fort-worth-nature-center-pass","subject_type":"activity","entity_name":"Fort Worth Nature Center & Refuge pass","title":"Borrow a Nature Center pass","subtitle":"Fort Worth Nature Center & Refuge via Fort Worth Public Library","notes":"Check pass availability through the library, borrow one before the trip, and use it for a low-cost-free outdoor visit with your group.","short_summary":"Library cardholders can get free general admission through the city’s pass program.","evidence_claim":"Fort Worth Public Library states that cardholders can check out passes for free general admission to the Fort Worth Nature Center & Refuge.","source_url":"https://www.fortworthtexas.gov/departments/library/services/13-nature-center-passes","source_title":"Nature Center Passes | City of Fort Worth","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Requires an available Fort Worth Public Library pass; check the library page for current checkout details.","cost_status":"free","under21_safe":true},{"subject_id":"log-cabin-village-pass","subject_type":"activity","entity_name":"Log Cabin Village pass","title":"Reserve a Log Cabin Village pass","subtitle":"Log Cabin Village via Fort Worth Public Library","notes":"Use a Fort Worth Public Library card to reserve a pass, then plan a self-guided visit around the village’s historic structures.","short_summary":"The city library’s pass program includes free access to Log Cabin Village.","evidence_claim":"Fort Worth P