 — NC State University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Public exhibit access is described by the Libraries; consult current building hours before visiting.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
