emic Finish Line","source_kind":"university_official","source_published_at":"2016-10-18","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The center later moved to Level 2 of the Extended Learning Building; verify current center hours and room availability before visiting.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"csusm-stem-success-center","subject_type":"study_space","entity_name":"STEM Success Center","title":"Study Beside Drop-In STEM Help","subtitle":"A Level 2 academic-support center in the Extended Learning Building","notes":"Bring a STEM assignment for independent work, then use drop-in tutoring when a question stalls you; check the current service schedule before arriving.","short_summary":"A study-friendly support center where students can work near tutors and academic resources.","evidence_claim":"CSUSM's academic-support guide invites students to spend time studying at the STEM Success Center and lists drop-in tutoring, laptops, textbooks, and study resources.","source_url":"https://www.csusm.edu/dos/documents/academic_support_resources_flyer_2023.pdf","source_title":"Academic Support Resources","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Located with CLASS on Level 2 of the Extended Learning Building; consult the center's current tutoring and building schedule.","cost_status":"not_applicable","under21_safe":true}],"warnings":[]}],"warnings":[]}
