oduct availability.","cost_status":"purchase_required","under21_safe":true},{"subject_id":"red-door-104-north-main","subject_type":"street_or_district","entity_name":"Red Door 104","title":"Check the Workshop Calendar","subtitle":"104 North Main Street corridor","notes":"Look for the red door on North Main Street, then consult the studio schedule for an arts or crafts class that matches your date and experience level.","short_summary":"A named downtown studio provides a hands-on arts stop on North Main Street.","evidence_claim":"Visit Farmville identifies Red Door 104 at 104 North Main Street and says it offers arts-and-crafts workshops and classes.","source_url":"https://visitfarmville.com/shopping/","source_title":"Shopping - Visit Farmville","source_kind":"other_reliable","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Workshop schedules and participation costs vary; verify the current calendar with the studio before visiting.","cost_status":"purchase_required","under21_safe":true}],"warnings":[]}],"warnings":[]}
