ree daily seasonal access.","evidence_claim":"The Town of Amherst states that Groff Park Spray Pad is free and open daily.","source_url":"https://www.amherstma.gov/m/newsflash/Home/Detail/3974","source_title":"Staying Cool During Extreme Heat","source_kind":"government","source_published_at":"2026-07-14","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Town guidance lists daily hours of 10 a.m.–8 p.m., with Tuesday opening at noon for maintenance; verify seasonal status before going.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
