tem.","source_url":"https://web.uri.edu/library/services/spaces/study-spaces/","source_title":"Study Spaces","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"No separate admission or room fee is listed. Availability and reservation requirements apply.","cost_status":"free","under21_safe":true},{"subject_id":"uri-fascitelli-fitness-center","subject_type":"place","entity_name":"Anna Fascitelli Fitness and Wellness Center","title":"Work out at Fascitelli","subtitle":"Campus Recreation, Kingston Campus","notes":"Plan a workout together, bring your URI ID, and use equipment on a first-come basis. Choose routines that suit everyone in your group.","short_summary":"A student-access fitness hang with no separate membership purchase.","evidence_claim":"URI says student Campus Recreation membership is included with tuition and includes access to the Anna Fascitelli Fitness and Wellness Center.","source_url":"https://web.uri.edu/campusrec/membership/","source_title":"Campus Recreation Memberships","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Eligible enrolled URI students have membership included with tuition; present valid URI ID or membership access. Guests may pay separately.","cost_status":"free","under21_safe":true},{"subject_id":"uri-mackal-field-house","subject_type":"place","entity_name":"Mackal Field House","title":"Move around at Mackal Field House","subtitle":"Campus Recreation, Kingston Campus","notes":"Use the facility for an active break with friends when its schedule permits. Bring your URI ID and follow staff directions and posted activity rules.","short_summary":"An indoor recreation option covered by eligible student membership.","evidence_claim":"URI says student Campus Recreation membership is included with tuition and includes access to Mackal Field House.","source_url":"https://web.uri.edu/campusrec/membership/","source_title":"Campus Recreation Memberships","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Eligible enrolled URI students have membership included with tuition; facility hours and scheduled use affect availability.","cost_status":"free","under21_safe":true},{"subject_id":"uri-tootell-aquatic-center","subject_type":"place","entity_name":"Tootell Aquatic Center","title":"Meet for a swim at Tootell","subtitle":"Campus Recreation, Kingston Campus","notes":"Check the pool schedule, bring swimwear and your URI ID, and meet during an available recreation session. Follow lifeguard and facility instructions.","short_summary":"A student-membership swim outing when the pool schedule allows.","evidence_claim":"URI says student Campus Recreation membership is included with tuition and includes access to the Tootell Aquatic Center.","source_url":"https://web.uri.edu/campusrec/membership/","source_title":"Campus Recreation Memberships","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Eligible enrolled URI students have membership included with tuition. Pool access depends on posted hours, lifeguard coverage, and facility rules.","cost_status":"free","under21_safe":true},{"subject_id":"uri-group-exercise-classes","subject_type":"activity","entity_name":"URI Campus Recreation Group Exercise Classes","title":"Try a group exercise class","subtitle":"Campus Recreation facilities, Kingston Campus","notes":"Pick a class that fits your group’s comfort level and register when the window opens. Arrive ready to check in with your URI ID or member pass.","short_summary":"Scheduled fitness classes with no separate class charge for members.","evidence_claim":"URI states that all group exercise classes are offered free of charge to students and members, with advance registration required.","source_url":"https://web.uri.edu/campusrec/fitness-and-wellness/group-exercise/policies/","source_title":"Fitness & Wellness Policies","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Free to students and members, but preregistration is required and access requires valid URI ID or membership pass.","cost_status":"free","under21_safe":true},{"subject_id":"uri-outdoor-recreation-fields","subject_type":"place","entity_name":"URI Outdoor Recreation Fields","title":"Gather at the outdoor recreation fields","subtitle":"Campus Recreation, Kingston Campus","notes":"Coordinate a casual outdoor activity or meet-up when the fields are not reserved. Check the facility schedule and leave the area as you found it.","short_summary":"Campus recreation fields for eligible member use.","evidence_claim":"URI lists Outdoor Recreation Fields among its Campus Recreation facilities, which are open to people with a Campus Recreation membership.","source_url":"https://web.uri.edu/campusrec/facilities/","source_title":"Campus Recreation Facilities","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Eligible enrolled URI students have membership included with tuition. Field access is subject to reservations, conditions, and posted policies.","cost_status":"free","under21_safe":true},{"subject_id":"uri-5k-run-course","subject_type":"activity","entity_name":"URI 5K Run Course","title":"Walk the URI 5K Run Course","subtitle":"Campus Recreation, Kingston Campus","notes":"Choose a walking pace that works for everyone and use the marked route as a reason to catch up. Check conditions and remain aware of traffic.","short_summary":"A structured campus route for a no-extra-cost walking hang.","evidence_claim":"URI lists the 5K Run Course as a Campus Recreation facility; URI states enrolled students’ Campus Recreation membership is included with tuition.","source_url":"https://web.uri.edu/campusrec/facilities/","source_title":"Campus Recreation Facilities","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Eligible enrolled URI students have membership included with tuition. Check current campus and recreation guidance before using the route.","cost_status":"free","under21_safe":true}],"warnings":["Campus Recreation access is free at point of use for eligible enrolled URI students because membership is included with tuition; guests and non-enrolled visitors may face charges.","Library rooms, recreation facilities, and outdoor areas can have changing hours, reservations, closures, or access requirements."]}],"warnings":[]}
