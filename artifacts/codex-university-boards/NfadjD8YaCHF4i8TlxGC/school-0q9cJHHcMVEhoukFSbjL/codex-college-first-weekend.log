ice-focused commons building connected to Community Commons.","evidence_claim":"DU lists the Food Pantry, Pioneer ID Card Office, Student Disability Services, bookstore, and bank among Driscoll Commons services.","source_url":"https://studentaffairs.du.edu/Driscoll-Community-Commons","source_title":"Driscoll & Community Commons | Student Affairs","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Service availability varies by office; verify individual office hours before making a special trip.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
