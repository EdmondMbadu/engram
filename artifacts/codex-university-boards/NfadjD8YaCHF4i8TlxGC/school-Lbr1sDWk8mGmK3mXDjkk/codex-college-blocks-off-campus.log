htm","source_title":"District of Columbia War Memorial","source_kind":"government","source_published_at":"2025-12-03","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Outdoor National Mall memorial; follow posted site guidance.","cost_status":"unknown","under21_safe":true},{"subject_id":"world-war-ii-memorial","subject_type":"street_or_district","entity_name":"World War II Memorial","title":"Walk the World War II Memorial plaza","subtitle":"17th Street NW corridor","notes":"Enter the memorial between the Lincoln Memorial and Washington Monument and trace the state and territorial pillars around the central fountain.","short_summary":"A National Mall memorial positioned between the Lincoln Memorial and Washington Monument.","evidence_claim":"NPS includes the World War II Memorial among the sites preserved by National Mall and Memorial Parks.","source_url":"https://www.nps.gov/thingstodo/visit-national-mall-and-memorial-parks.htm","source_title":"Visit National Mall and Memorial Parks","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Outdoor National Mall memorial; follow posted site guidance.","cost_status":"free","under21_safe":true},{"subject_id":"albert-einstein-memorial","subject_type":"street_or_district","entity_name":"Albert Einstein Memorial","title":"Visit the Albert Einstein Memorial","subtitle":"Constitution Avenue NW corridor","notes":"Stop at the National Academy of Sciences grounds to see the Einstein memorial, unveiled for the centennial of the scientist’s birth.","short_summary":"A memorial sculpture on the National Academy of Sciences grounds.","evidence_claim":"The National Academy of Sciences states that the Albert Einstein Memorial was unveiled in 1979 and stands on the Academy grounds.","source_url":"https://www.nasonline.org/about-the-nas/locations/","source_title":"National Academy of Sciences Locations","source_kind":"other_reliable","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The memorial is on Academy grounds; the NAS Building itself is closed to the public except for authorized visitors.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
