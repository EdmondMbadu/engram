xperience/our-campus/student-spaces-resources","source_title":"Student Spaces & Resources | Simmons University","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":"https://www.simmons.edu/maps-directions/campus-maps","access_notes":"Simmons lists the facility at 331 Brookline Avenue and says it serves students and members; confirm current recreation access.","cost_status":"unknown","under21_safe":true},{"subject_id":"simmons-library-group-study-rooms","subject_type":"study_space","entity_name":"Simmons University Library Group Study Rooms","title":"Reserve a library room for a group session","subtitle":"Simmons University Library, Lefavour Hall","notes":"Reserve a group study room in advance for a project meeting, presentation rehearsal, or shared work block; bookings are offered in three-hour blocks.","short_summary":"Twenty reservable library rooms for group work of up to eight people.","evidence_claim":"The Simmons University Library has 20 group study rooms for student use, each accommodating up to eight people and reservable in three-hour blocks.","source_url":"https://www.simmons.edu/library/research-study/rooms-spaces","source_title":"Rooms and Spaces | Simmons University Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":"https://www.simmons.edu/maps-directions/campus-maps","access_notes":"Student rooms may be reserved up to 28 days ahead through the Library Study Room Reservations system; booking ahead is recommended.","cost_status":"unknown","under21_safe":true},{"subject_id":"simmons-library-low-sensory-study-room","subject_type":"study_space","entity_name":"Low-Sensory Study Room","title":"Choose the Low-Sensory Study Room","subtitle":"Simmons University Library, Lefavour Hall","notes":"When you need fewer distractions, reserve this room and plan a quiet individual study block around its reduced-light environment.","short_summary":"A reservable library room designed for students with different sensory preferences.","evidence_claim":"Simmons designates the Low-Sensory Study Room for different sensory preferences and says it has reduced lighting designed to minimize distraction.","source_url":"https://www.simmons.edu/library/research-study/rooms-spaces","source_title":"Rooms and Spaces | Simmons University Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":"https://www.simmons.edu/maps-directions/campus-maps","access_notes":"Reserve through the library’s Low Sensory Study Room reservation link; confirm availability before visiting.","cost_status":"unknown","under21_safe":true},{"subject_id":"simmons-library-24-hour-silent-study-room","subject_type":"study_space","entity_name":"24-Hour Silent Study Room","title":"Settle into the 24-Hour Silent Study Room","subtitle":"Lefavour Hall, first floor, E-101","notes":"Use this ultra-quiet room for focused individual work when other library spaces are busy; bring your Simmons ID for entry.","short_summary":"An ID-access study room dedicated to ultra-quiet work around the clock.","evidence_claim":"Simmons says its 24-Hour Silent Study Room is open daily to Simmons University ID holders and intended for ultra-quiet work.","source_url":"https://www.simmons.edu/library/research-study/rooms-spaces","source_title":"Rooms and Spaces | Simmons University Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":"https://www.simmons.edu/maps-directions/campus-maps","access_notes":"The library lists E-101 in Lefavour Hall as open 24 hours a day, seven days a week; Simmons University ID is required.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
