lic areas respectfully.","cost_status":"unknown","under21_safe":true},{"subject_id":"geneseo-campus-activities-board","subject_type":"activity","entity_name":"Geneseo Campus Activities Board","title":"End by scanning GCAB’s next programs","subtitle":"Sunday planning · campus events","notes":"Review the board’s upcoming offerings and save one event that interests you, using the official calendar to verify the date, location, and entry details.","short_summary":"A forward-looking final stop that creates an easy reason to reconnect with campus next week.","evidence_claim":"SUNY Geneseo says the Geneseo Campus Activities Board organizes SA-funded programming year-round and hosts events including concerts, art shows, and seasonal campus programs.","source_url":"https://www.geneseo.edu/gcab","source_title":"Geneseo Campus Activities Board - SUNY Geneseo","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Programs vary by date. Verify the event’s current details and any registration or admission requirements before attending.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
