Writing Center Annex","subtitle":"Lower Level, Musselman Library","notes":"Use the Library Annex calendar when booking writing help, especially if the Breidenbaugh schedule has no opening that fits your work session.","short_summary":"The Writing Center's second in-person location.","evidence_claim":"The Gettysburg Writing Center operates an in-person Annex on Musselman Library's lower level, with a separate appointment calendar from its Breidenbaugh location.","source_url":"https://www.gettysburg.edu/academic-programs/english/student-opportunities/the-writing-center.dot","source_title":"The Writing Center","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Appointments are encouraged and walk-ins depend on tutor availability; check the Library location's separate calendar.","cost_status":"unknown","under21_safe":true},{"subject_id":"donna-brogan-center-quantitative-learning","subject_type":"study_space","entity_name":"Donna Brogan Center for Quantitative Learning","title":"Brogan Center for Quantitative Learning","subtitle":"Room 012, Ground Floor, Glatfelter Hall","notes":"Work through equations on the wall or table whiteboards, connect your device to the pop-up monitor, or drop in during a listed tutoring session.","short_summary":"A 24-hour quantitative-learning hub with extensive whiteboard space.","evidence_claim":"The Brogan Center in Glatfelter 012 is open 24 hours and includes 84 feet of whiteboard space, two whiteboard tables, four computers, and a device-connectable monitor.","source_url":"https://www.gettysburg.edu/offices/center-student-success/academic-support/donna-brogan-center-quantitative-learning","source_title":"Donna Brogan Center for Quantitative Learning","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Open 24 hours; the center itself is not reservable. The College publishes a drop-in tutoring schedule on its page.","cost_status":"unknown","under21_safe":true},{"subject_id":"bloomberg-terminal-lab","subject_type":"study_space","entity_name":"Bloomberg Terminal Lab","title":"Bloomberg Terminal Lab","subtitle":"Above the Bullet Hole, College Union Building","notes":"Use this 24/7 campus lab when your coursework calls for real-time financial data, news, or analytics rather than a standard computer workspace.","short_summary":"A College Union Building lab for finance-focused research.","evidence_claim":"Gettysburg College established a 24/7 Bloomberg Terminal Lab above the Bullet Hole in the College Union Building for real-time financial data, news, and analytics.","source_url":"https://www.gettysburg.edu/news/magazine/2025/summer/summer-magazine-2025.pdf","source_title":"Gettysburg College Magazine, Summer 2025","source_kind":"university_official","source_published_at":"2025-06-01","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The College reported it would be ready for Fall 2025 use and described it as a 24/7 lab; verify current access procedures with the College before visiting.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
