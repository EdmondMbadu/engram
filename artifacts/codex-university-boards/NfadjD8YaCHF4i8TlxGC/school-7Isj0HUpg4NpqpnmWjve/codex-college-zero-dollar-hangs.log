_safe":true},{"subject_id":"university-park-neighborhood-association-meeting","subject_type":"activity","entity_name":"University Park Neighborhood Association general meeting","title":"Attend a University Park neighborhood meeting","subtitle":"Chiles Center, University of Portland","notes":"Check the association’s listing before going, then attend to hear neighborhood discussion and meet local residents; the City states that everyone is welcome.","short_summary":"A public neighborhood conversation hosted at UP’s Chiles Center.","evidence_claim":"The City of Portland says University Park Neighborhood Association general meetings are held at UP’s Chiles Center, are open to the public, and welcome everyone.","source_url":"https://www.portland.gov/neighborhoods/university-park","source_title":"University Park neighborhood | City of Portland","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Confirm the current date, location, and format with the association before attending; the City’s listing says general meetings are open to the public.","cost_status":"free","under21_safe":true}],"warnings":["For park cards, cost-free status covers the listed walking, table, and casual-use activity only; reservable sites, sports fields, parking, pools, and equipment can have separate rules or costs."]}],"warnings":[]}
