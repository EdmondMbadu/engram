nter gallery used for University exhibition programming.","evidence_claim":"University of Portland’s event calendar identifies the Buckley Center Art Gallery on the first floor as a venue for an art exhibit and reception.","source_url":"https://calendar.up.edu/buckley_center","source_title":"Buckley Center | University of Portland Events Calendar","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Exhibition availability depends on the University’s current calendar and gallery schedule.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
