r-study-rooms","subject_type":"study_space","entity_name":"Mudd Library Second-Floor Study Rooms","title":"Book a small room for one or two","subtitle":"Compact study rooms reservable for sessions of up to three hours","notes":"Write your reservation on the clipboard at the room, keep the session within three hours, and use the space alone or with one partner.","short_summary":"Small unlocked rooms sized for focused solo work or a two-person collaboration.","evidence_claim":"Lawrence provides second-floor study rooms for one or two students that can be reserved for up to three hours and should remain unlocked.","source_url":"https://www.lawrence.edu/library/spaces","source_title":"Spaces in the Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Reserve on the clipboard posted at the door for no more than three hours; individual room entry does not require an ID, but library building access does.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"lawrence-mudd-music-lab-116","subject_type":"study_space","entity_name":"Mudd Library Music Lab, Room 116","title":"Move a score from page to playback","subtitle":"Music-focused workstations, keyboards, scanners, and listening gear","notes":"Use the MIDI keyboards and composition software for arranging, or scan a score at the large-format station before reviewing it at the piano.","short_summary":"A first-floor lab built for score study, composition, digitization, and close listening.","evidence_claim":"Room 116 is open to the Lawrence community and contains a Yamaha digital piano, score-scanning equipment, Mac workstations with MIDI keyboards and music software, and a listening station.","source_url":"https://www.lawrence.edu/library/spaces","source_title":"Spaces in the Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The Music Lab is available to members of the Lawrence University community; Mudd Library requires Lawrence card access during open hours.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"lawrence-mudd-itc-computer-lab","subject_type":"study_space","entity_name":"Mudd Library ITC Computer Lab","title":"Use a full computer station between reservations","subtitle":"Seventeen login computers beside the Technology Services help desk","notes":"Check that the lab is not reserved, sign in at one of the 17 computers, and use the nearby help desk when a campus account or device blocks progress.","short_summary":"A sizable second-floor computer lab with technical assistance close at hand.","evidence_claim":"Lawrence locates the ITC Computer Lab on Mudd Library’s second floor and says its 17 login computers are open for use when the room is not reserved.","source_url":"https://www.lawrence.edu/library/spaces","source_title":"Spaces in the Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Open when not otherwise reserved; computers require a login, and library building access requires a Lawrence card during open hours.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"lawrence-mudd-makerspace","subject_type":"study_space","entity_name":"Lawrence University Makerspace","title":"Prototype the assignment instead of describing it","subtitle":"A trained-access workspace for hands-on academic projects","notes":"Complete the initial and equipment-specific training, attend an open session, then reserve the machine needed for your academic project.","short_summary":"A project workspace where trained students can turn academic ideas into physical prototypes.","evidence_claim":"Lawrence says its makerspace supports academic work with hands-on tools and innovative equipment; users must complete training and reserve equipment time afterward.","source_url":"https://www.lawrence.edu/academics/advising-support/library/spaces/makerspace/","source_title":"Makerspace","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Initial and equipment-specific training are required; after training, students must reserve equipment time. Library card-access rules also apply.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"lawrence-mudd-third-floor-quiet-study","subject_type":"study_space","entity_name":"Mudd Library Third-Floor Quiet Study","title":"Choose quiet without committing to silence","subtitle":"A full library floor designated for lower-volume study","notes":"Head to the third floor for reading or writing that benefits from quiet, and move group discussion to a designated collaboration room.","short_summary":"A floor-wide quiet zone offering a middle ground between collaborative and silent study.","evidence_claim":"Lawrence officially designates the third floor of Mudd Library for quiet study.","source_url":"https://www.lawrence.edu/library/spaces","source_title":"Spaces in the Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Observe the floor’s quiet-study designation; Mudd Library requires Lawrence card access during all open hours.","cost_status":"not_applicable","under21_safe":true}],"warnings":[]}],"warnings":[]}
