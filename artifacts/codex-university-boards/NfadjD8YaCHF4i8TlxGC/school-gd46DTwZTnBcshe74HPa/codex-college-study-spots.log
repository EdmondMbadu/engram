es":"Work from the varied seating, computer workstations, scanner, or printer; for a room, use one of three first-come rooms or the Reserve a Space feature.","short_summary":"Campus-wide science-library seating with research technology and three bookable study rooms.","evidence_claim":"The Science Library is open to the entire campus community and provides varied seating, high-speed internet, workstations, a scanner, printer, and three first-come study rooms.","source_url":"https://libraries.olemiss.edu/about/science-library/","source_title":"Science Library | University of Mississippi Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"On the first floor of the Thad Cochran Research Center; study rooms are first come, first served and can be booked through Reserve a Space.","cost_status":"unknown","under21_safe":true},{"subject_id":"duff-center-private-study-rooms","subject_type":"study_space","entity_name":"Duff Center Private Study Rooms","title":"Duff Center Private Study Rooms","subtitle":"Jim and Thomas Duff Center for Science and Technology Innovation","notes":"Use a group study room during regular operating hours for whiteboards, video conferencing, flat-screen displays, and ergonomic chairs; confirm hours before heading over.","short_summary":"STEM-building group rooms designed around screens, whiteboards, and collaborative work.","evidence_claim":"The Duff Center's group study rooms and tutoring spaces have video conferencing, flat-screen TVs, whiteboards, and ergonomic chairs, and are open for student use during regular hours.","source_url":"https://olemiss.edu/departments/research/center-for-stem-learning/duff-center/","source_title":"The Duff Center | University of Mississippi","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Student use is during regular operating hours; the center lists Monday-Friday 7 a.m.-10 p.m. and notes that hours may change during finals or outside fall and spring.","cost_status":"unknown","under21_safe":true},{"subject_id":"grisham-law-library-reading-room","subject_type":"study_space","entity_name":"Grisham Law Library Reading Room","title":"Grisham Law Library Reading Room","subtitle":"Grisham Law Library, first floor","notes":"If you are in the law school community, reserve a seat up to two days ahead; use this quiet-study room for reading or individual work rather than calls.","short_summary":"A quiet, reservable first-floor reading room for eligible law-library users.","evidence_claim":"The Reading Room is a first-floor quiet study area with reservable seats; the reservation system is limited to law students, faculty, and staff.","source_url":"https://library.law.olemiss.edu/resources/book-a-room-3-2/","source_title":"Seat and Room Booking | Grisham Law Library","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Seat reservations are available up to two days ahead for up to eight hours daily; law-center access is restricted to the law school community on evenings and weekends.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
