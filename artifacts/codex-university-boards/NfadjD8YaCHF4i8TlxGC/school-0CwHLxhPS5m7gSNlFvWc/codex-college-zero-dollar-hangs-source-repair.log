rce_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Posted for Saturdays, 10–11 a.m., and suitable for all ages and skill levels. Bring your own sketch pad and pencils; check the page for schedule changes.","cost_status":"free","under21_safe":true},{"subject_id":"fairfield-nature-center-animals","subject_type":"place","entity_name":"Fairfield Nature Center","title":"Meet the Nature Center's Animals","subtitle":"Raptors and ambassador animals at no charge","notes":"Visit during center hours to see the Birds of Prey Compound and indoor animal exhibits, with no need to buy from the nature store.","short_summary":"A free wildlife-focused visit featuring educational animals and exhibit areas.","evidence_claim":"Connecticut Audubon's official page lists free admission and says the Fairfield Nature Center has a Birds of Prey Compound and indoor ambassador-animal exhibits.","source_url":"https://ctaudubon.org/locations/the-fairfield-nature-center-and-larsen-sanctuary/","source_title":"The Fairfield Nature Center & Larsen Sanctuary | The Connecticut Audubon Society","source_kind":"cultural_institution","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The center is posted open Monday–Saturday, 10 a.m.–3 p.m., with free admission. The nature store is optional and no purchase is required.","cost_status":"free","under21_safe":true},{"subject_id":"larsen-wildlife-sanctuary-trails","subject_type":"activity","entity_name":"Roy and Margot Larsen Wildlife Sanctuary","title":"Hike the Larsen Sanctuary","subtitle":"Seven miles of woodland and wetland trails","notes":"Choose a designated trail that fits your group, stay on the marked route, and leave dogs, bicycles, drones, and collecting plans at home.","short_summary":"A dawn-to-dusk trail outing across ponds, forest, fields, and boardwalks.","evidence_claim":"The official sanctuary page states that Larsen offers seven miles of trails, including an accessible mile-long trail, open dawn to dusk year-round with free admission.","source_url":"https://ctaudubon.org/locations/the-fairfield-nature-center-and-larsen-sanctuary/","source_title":"The Fairfield Nature Center & Larsen Sanctuary | The Connecticut Audubon Society","source_kind":"cultural_institution","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Trails are open dawn to dusk year-round and admission is free. Walkers and birders must use designated trails; dogs, bicycles, and drones are prohibited.","cost_status":"free","under21_safe":true},{"subject_id":"lake-mohegan-open-space-hike","subject_type":"activity","entity_name":"Lake Mohegan Open Space Area","title":"Take the Lake Mohegan Trail Loop","subtitle":"A free 1.6- or 2.5-mile woodland hike","notes":"Download the trail map, wear shoes suited to rocks and packed dirt, and pick the red or yellow route according to your available time.","short_summary":"A free hike through restored open space, with a longer route reaching the Cascades.","evidence_claim":"The Town of Fairfield tourism page documents 1.6- and 2.5-mile Lake Mohegan trail options and states that parking for hiking is free; the seasonal fee applies to the swimming area.","source_url":"https://experiencefairfieldct.squarespace.com/walking-tour-the-lake-mohegan-walk","source_title":"The Lake Mohegan Walk — Experience Fairfield CT","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Hiking parking is free. From the Saturday before Memorial Day through Labor Day, a separate gate fee applies only to entry into the swimming area; remain in the open-space trail system for this no-cost activity.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
