ies.","evidence_claim":"Hope College documents student use of the Dow Center’s gymnasium, dance studios, conditioning area, indoor track, racquetball courts, and pool, and states Hope students may access the facility for free.","source_url":"https://hope.edu/directory/buildings/dow-center/index.html","source_title":"Dow Center","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Hope students have free access; bring campus identification and check current hours, registrations, and area-specific availability.","cost_status":"free","under21_safe":true},{"subject_id":"hope-kruizenga-art-museum","subject_type":"place","entity_name":"Kruizenga Art Museum","title":"Reset Your Attention With an Exhibition","subtitle":"Campus galleries on Columbia Avenue","notes":"Plan a quiet exhibition visit after the museum reopens August 28; leave large bags in the lobby and follow gallery photography rules.","short_summary":"An accessible campus museum where students can spend time with rotating art exhibitions outside a classroom setting.","evidence_claim":"The museum’s current visit page says it is closed from May 18 through August 27, reopens August 28, is fully accessible, permits limited non-flash photography, and lists free admission for its named exhibitions.","source_url":"https://hope.edu/arts/kam/visit.html","source_title":"Visit | Kruizenga Art Museum","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Closed for summer through August 27, 2026; scheduled to reopen August 28. Closed Sundays, Mondays, holidays, and college closures.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
