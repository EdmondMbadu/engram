ersity_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Reservation is available in advance; room availability is not guaranteed without one.","cost_status":"unknown","under21_safe":true},{"subject_id":"unr-el-wiegand-fitness-center","subject_type":"place","entity_name":"E. L. Wiegand Fitness Center","title":"E. L. Wiegand Fitness Center","subtitle":"Fitness and Recreational Sports, north campus","notes":"Use the open gym, track, fitness areas, or scheduled activities after confirming your membership and completing the required annual recreation waiver.","short_summary":"A campus recreation center with courts, cardio and weight-training areas, track, and activity studios.","evidence_claim":"University Fitness and Recreational Sports lists basketball/volleyball courts, weightlifting and cardio areas, a running track, and activity studios at Wiegand Fitness Center.","source_url":"https://www.unr.edu/fitness/facilities","source_title":"Fitness Facilities | Fitness & Recreational Sports","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"An active membership and University ID are required to enter Fitness and Recreational Sports buildings; patrons must complete an annual waiver.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
