g software.","evidence_claim":"University Libraries describes the second-floor DeLaMare Audio Room as having an isolation booth, two microphones, and professional recording and editing software; reservations are strongly recommended.","source_url":"https://library.unr.edu/places/delamare-library/resources/specialty-tech-spaces--delamare","source_title":"Specialty tech spaces at DeLaMare | University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"A key is checked out from the Makerspace desk; online reservations are strongly recommended to ensure availability.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"unr-mikc-dynamic-media-lab-108","subject_type":"study_space","entity_name":"Dynamic Media Lab","title":"Dynamic Media Lab","subtitle":"MIKC 108, Mathewson-IGT Knowledge Center","notes":"Use a dual-monitor Mac workstation to edit class media, and check whether the lab is available before beginning a longer production session.","short_summary":"An 18-workstation media-production lab for video, audio, graphics, and editing.","evidence_claim":"University Libraries locates the Dynamic Media Lab in MIKC 108 and lists 18 dual-monitor Mac Studio workstations, recording rooms, and video and audio editing software.","source_url":"https://library.unr.edu/resources/computers-and-software","source_title":"Computers and Software | University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Available when the Knowledge Center is open and the lab is not in use by a class; verify current hours and availability.","cost_status":"not_applicable","under21_safe":true}],"warnings":[]}],"warnings":[]}
