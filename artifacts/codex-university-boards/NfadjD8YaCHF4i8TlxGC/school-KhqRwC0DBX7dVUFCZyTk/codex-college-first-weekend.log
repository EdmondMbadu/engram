nters/research-centers","source_title":"Research Centers","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Use the exterior as the dependable stop; interior rooms, workshops, and equipment may require authorization or scheduled access.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"ping-tom-natural-area-finale","subject_type":"sequence_stop","entity_name":"Ping Tom Natural Area","title":"Finish Beside the Chicago River","subtitle":"Sunday late afternoon · A public-landscape finale in Chinatown","notes":"Explore the paved paths and elevated boardwalk, watch for wetland and prairie habitat, and leave wildlife undisturbed.","short_summary":"A riverfront conclusion with accessible paths and native habitat.","evidence_claim":"The Chicago Park District says Ping Tom Natural Area has more than three acres of prairie and wetland habitat, paved paths, an accessible overlook, and daily 6 a.m.–10 p.m. hours.","source_url":"https://www.chicagoparkdistrict.com/parks-facilities/ping-tom-natural-area","source_title":"Ping Tom Natural Area","source_kind":"government","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Open 6 a.m.–10 p.m. daily according to the current Park District page; follow posted natural-area rules.","cost_status":"unknown","under21_safe":true}],"warnings":["The sequence is evergreen rather than event-specific; verify live library, recreation, dining, building, transit, and seasonal beach conditions before departure.","Coordinates and maps URLs are null because they were not independently verified from the cited direct evidence pages.","The historical-marker route is marked free because the university documents outdoor campus markers intended for visitors; it does not require admission or a purchase."]}],"warnings":[]}
