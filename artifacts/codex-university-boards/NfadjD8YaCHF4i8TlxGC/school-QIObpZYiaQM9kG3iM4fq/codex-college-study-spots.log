ort_summary":"A 16-seat lower-level room with windows, five PCs, and presentation tools.","evidence_claim":"The Dewey Large Group Study Room is on the lower level, overlooks the Quiet Study area, has a wall of windows, 16 seats, five PCs, a whiteboard, presenter station, and large-screen TV.","source_url":"https://library.albany.edu/services/rooms","source_title":"Study & Technology Rooms | University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Located on the lower level of Dewey Graduate Library; use the library’s booking link for the Dewey Classroom to request it.","cost_status":"unknown","under21_safe":true},{"subject_id":"ualbany-dewey-office-1-room-201","subject_type":"study_space","entity_name":"Dewey Office 1 (Room 201)","title":"Dewey Office 1 (Room 201)","subtitle":"Dewey Graduate Library · Balcony Level","notes":"Reserve this two-person office for a one-on-one work session or virtual meeting, using its dual monitors, webcam, whiteboard, and natural light.","short_summary":"A loanable two-person balcony office with dual monitors and a webcam.","evidence_claim":"Dewey Office 1, Room 201, is a loanable office for in-person or virtual meetings and study needs; it seats two and includes dual monitors, an HD webcam, whiteboard, and natural light.","source_url":"https://library.albany.edu/services/rooms","source_title":"Study & Technology Rooms | University Libraries","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Seats two maximum and is located on the Dewey Graduate Library balcony level; reserve through the library’s room-booking page.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
