.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"iub-lgbtq-culture-center","subject_type":"place","entity_name":"LGBTQ+ Culture Center","title":"Do Homework in an Affirming Gathering Space","subtitle":"Resources, community, and a place to settle in","notes":"Stop in to work, browse the LGBTQ+ library, or ask staff about campus resources; use the accessible rear ramp if needed.","short_summary":"A student support center that explicitly welcomes homework and informal connection.","evidence_claim":"The IU LGBTQ+ Culture Center says it is an inclusive gathering space and specifically invites students to hang out, do homework, meet people, and use its LGBTQ+ library.","source_url":"https://lgbtq.indiana.edu/about/cc-and-qsu.html","source_title":"We welcome you!: LGBTQ+ Culture Center","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Located at 705 E. Seventh Street. The center lists Monday–Friday hours of 9 a.m.–5 p.m.; the first floor is accessible via a rear ramp.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"iub-first-nations-educational-cultural-center","subject_type":"place","entity_name":"First Nations Educational & Cultural Center","title":"Connect at the Native Student Gathering Place","subtitle":"A central hub for Native experience at IU","notes":"Visit for connection, cultural programming, or student support, and approach the center as a community space with a specific mission.","short_summary":"A dedicated gathering place supporting Native and Indigenous students.","evidence_claim":"IU describes the First Nations Educational & Cultural Center as a gathering place and central hub for Native American students, offering support, resources, and cultural activities.","source_url":"https://firstnations.indiana.edu/about/index.html","source_title":"About: First Nations Educational & Cultural Center","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"This is a mission-specific community and support space. Review the center’s current contact and program information before planning a visit.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"iub-imu-interfaith-prayer-reflection-space","subject_type":"place","entity_name":"Interfaith Prayer and Reflection Space","title":"Pause Quietly Between Classes","subtitle":"Individual reflection inside the Indiana Memorial Union","notes":"Use this quiet room for individual prayer, reflection, or a brief reset, and preserve the calm, inclusive purpose of the space.","short_summary":"A designated quiet room for personal spiritual or reflective needs.","evidence_claim":"The Indiana Memorial Union describes its Interfaith Prayer and Reflection Space as a quiet, inclusive area where individuals can address personal or spiritual needs.","source_url":"https://imu.indiana.edu/activities-services/services/index.html","source_title":"Services: Indiana Memorial Union","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Located in the K.P. Williams Room on the IMU’s second floor. The official page lists the space as open daily from 8 a.m. to 10 p.m.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"iub-imu-student-involvement-leadership-center","subject_type":"place","entity_name":"Student Involvement and Leadership Center","title":"Give a Student Organization Somewhere to Work","subtitle":"Gathering and collaboration space in the IMU","notes":"Bring organization planning to the center’s gathering space, or ask support staff how to connect a project with IU student involvement resources.","short_summary":"An IMU base for student groups, collaboration, and involvement support.","evidence_claim":"The Indiana Memorial Union identifies the Student Involvement and Leadership Center as the home of student-organization gathering and collaboration space, IU Student Government, and support staff.","source_url":"https://imu.indiana.edu/activities-services/services/index.html","source_title":"Services: Indiana Memorial Union","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Located on the first floor of the Indiana Memorial Union. Organization spaces and staff services may follow their own schedules or eligibility rules.","cost_status":"not_applicable","under21_safe":true},{"subject_id":"iub-william-gayle-cook-music-library","subject_type":"study_space","entity_name":"William & Gayle Cook Music Library","title":"Work With Scores and Music Technology Nearby","subtitle":"A research environment built around music study","notes":"Set up a music-focused research session near the collections, then use the library computers or printers when notation and page size matter.","short_summary":"A specialized study environment connecting music research, technology, and performance.","evidence_claim":"The Cook Music Library says it supports musical performance, teaching, learning, and research, while its technology page documents public-area wireless access, computers, and three printers.","source_url":"https://libraries.indiana.edu/music-library-mission-and-vision","source_title":"Mission and Vision of the Cook Music Library","source_kind":"university_official","source_published_at":"2019-04-01","source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Street address is 200 S. Eagleson Avenue. General research is open to students, faculty, staff, and the public, but special collections have registration rules.","cost_status":"not_applicable","under21_safe":true}],"warnings":[]}],"warnings":[]}
