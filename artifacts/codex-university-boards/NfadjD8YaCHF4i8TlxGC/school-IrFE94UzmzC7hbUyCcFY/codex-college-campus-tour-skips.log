signated quiet areas.","short_summary":"A public-use multicultural center with study, reflection, and reservable spaces.","evidence_claim":"Trotter says it is open for public use, with spaces for quiet study and reflection; specific spaces can be reserved for events.","source_url":"https://trotter.umich.edu/frequently-asked-questions","source_title":"Trotter Multicultural Center Frequently Asked Questions","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Open public use is subject to current building hours; individual rooms may be reserved.","cost_status":"unknown","under21_safe":true},{"subject_id":"michigan-league-underground","subject_type":"study_space","entity_name":"Michigan League Underground","title":"Michigan League Underground","subtitle":"Lower level of the Michigan League, 911 North University Avenue","notes":"Set up at a table or booth for solo work or a small group. If you need the stage for practice or a performance, contact Conference and Event Services to reserve it.","short_summary":"A lower-level study space with tables, booths, and a reservable stage.","evidence_claim":"University Unions describes the Michigan League Underground as a place with tables and booths for studying alone or in groups, plus a reservable stage.","source_url":"https://uunions.umich.edu/spaces-places/","source_title":"Spaces & Places | University Unions","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Stage use requires coordination with Conference and Event Services; follow Michigan League building policies.","cost_status":"unknown","under21_safe":true},{"subject_id":"pierpont-commons","subject_type":"place","entity_name":"Pierpont Commons","title":"Pierpont Commons","subtitle":"2101 Bonisteel Boulevard, North Campus","notes":"Use the seating and study areas as a practical North Campus meeting point. The building also includes meeting rooms, shops, and services; confirm individual space availability on arrival.","short_summary":"North Campus student union with study space, meeting rooms, services, and food options.","evidence_claim":"University Unions identifies Pierpont Commons as U-M’s North Campus student union and states that it offers restaurants, meeting rooms, study spaces, shops, and services.","source_url":"https://uunions.umich.edu/pierpont-retail-space/","source_title":"Pierpont Commons Prime Retail Space","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Public common areas are subject to building operations; individual shops, services, and meeting rooms have separate availability.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
