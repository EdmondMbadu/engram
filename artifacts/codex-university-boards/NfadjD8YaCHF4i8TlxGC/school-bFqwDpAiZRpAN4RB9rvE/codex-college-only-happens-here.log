d_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Runs on Tuesdays during fall and spring semesters; giveaways are limited to the first eligible visitors and current tent details should be confirmed.","cost_status":"free","under21_safe":true},{"subject_id":"fau-pose-with-coach","subject_type":"tradition","entity_name":"Howard Schnellenberger Statue","title":"Strike the Coach’s Sideline Pose","subtitle":"Fans mirror FAU football’s founding coach inside Stadium Gate 1","notes":"On an FAU Stadium visit, find the statue just inside Gate 1 and recreate Schnellenberger’s pose without blocking pedestrian flow.","short_summary":"A stadium photograph imitates the stance of the coach who built Owl football.","evidence_claim":"FAU invites fans to pose with the Howard Schnellenberger statue, which depicts the founding football coach’s iconic pose and stands just inside Gate 1 at FAU Stadium.","source_url":"https://www.fau.edu/president/traditions/","source_title":"FAU Traditions | Florida Atlantic University","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"The statue is inside Gate 1 at FAU Stadium, so access may depend on stadium openings, event admission, and security procedures.","cost_status":"unknown","under21_safe":true}],"warnings":[]}],"warnings":[]}
