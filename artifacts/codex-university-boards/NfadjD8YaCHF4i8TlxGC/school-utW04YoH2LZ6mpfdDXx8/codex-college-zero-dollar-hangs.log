lity.","cost_status":"free","under21_safe":true},{"subject_id":"hpu-campus-croquet","subject_type":"activity","entity_name":"HPU Croquet","title":"Play a Round of Croquet","subtitle":"Laid-back outdoor recreation through HPU REC","notes":"Ask HPU REC where to collect the equipment and play, then invite a small group for an easygoing lawn-game session between classes.","short_summary":"Croquet offers a slower-paced group activity that does not require participants to own a set.","evidence_claim":"HPU Recreation Services lists Croquet among its outdoor leisure activities and states that all recreation services are complimentary to HPU students.","source_url":"https://www.highpoint.edu/recreationservices/","source_title":"Recreation Services","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Complimentary for HPU students. Confirm the current equipment checkout process, play location, and weather conditions with HPU REC.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
