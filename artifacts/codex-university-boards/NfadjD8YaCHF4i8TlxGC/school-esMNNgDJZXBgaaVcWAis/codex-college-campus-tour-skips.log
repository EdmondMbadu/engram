ulents.","evidence_claim":"UNC Charlotte Botanical Gardens says McMillan Greenhouse contains six themed collections across eight greenhouse rooms, terraces, beds, and a courtyard.","source_url":"https://gardens.charlotte.edu/gardens-and-greenhouse/","source_title":"Gardens and Greenhouse | UNC Charlotte Botanical Gardens","source_kind":"university_official","source_published_at":null,"source_fetched_at":"2026-08-13","latitude":null,"longitude":null,"maps_url":null,"access_notes":"Open Monday–Friday, 9 a.m.–4 p.m.; admission to the Greenhouse and Gardens is free, with visitor sign-in requested.","cost_status":"free","under21_safe":true}],"warnings":[]}],"warnings":[]}
