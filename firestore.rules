rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActivePersonalWikiPlan() {
      return isSignedIn()
        && (
          userProfile().pricingPlan in ['personal_plus', 'creator']
          || userProfile().pricing_plan in ['personal_plus', 'creator']
        )
        && (
          userProfile().subscriptionStatus in ['active', 'trialing', 'paid']
          || userProfile().subscription_status in ['active', 'trialing', 'paid']
        );
    }

    function canCreateWiki() {
      return isPlatformAdmin() || hasActivePersonalWikiPlan();
    }

    function userEditableProfileKeys() {
      return [
        'id',
        'authUid',
        'email',
        'emailVerified',
        'displayName',
        'photoURL',
        'profileIcon',
        'profilePictureType',
        'providers',
        'creationTime',
        'lastSignInTime',
        'updatedAt'
      ];
    }

    function isAtlasAdmin(data) {
      return isSignedIn()
        && data.admin_user_ids is list
        && request.auth.uid in data.admin_user_ids;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userEditableProfileKeys());
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userEditableProfileKeys());
      allow delete: if false;
    }

    match /atlases/{atlasId} {
      allow read: if resource.data.is_public == true
        || (isSignedIn() && resource.data.user_id == request.auth.uid)
        || isAtlasAdmin(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && canCreateWiki();
      allow update: if (isSignedIn() && resource.data.user_id == request.auth.uid)
        || (
          isAtlasAdmin(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'slug',
            'description',
            'landing_summary',
            'is_public',
            'logo_url',
            'hero_url',
            'video_url',
            'cover_color',
            'city_config',
            'chat_guide',
            'persona_prompt',
            'default_answer_mode',
            'updated_at'
          ])
        );
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /documents/{documentId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /raw_extracts/{extractId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /knowledge_entries/{entryId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /wiki_topics/{topicId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /wiki_articles/{articleId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /wiki_index/{indexId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /queries/{queryId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /chat_threads/{threadId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /chat_messages/{messageId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /public_chat_threads/{threadId} {
      allow read: if isSignedIn() && (
        resource.data.atlas_owner_user_id == request.auth.uid
        || resource.data.visitor_uid == request.auth.uid
      );
      allow write: if false;
    }

    match /public_chat_messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.atlas_owner_user_id == request.auth.uid
        || resource.data.visitor_uid == request.auth.uid
      );
      allow write: if false;
    }

    match /atlas_voice_tool_calls/{callId} {
      allow read: if isSignedIn() && resource.data.atlas_owner_user_id == request.auth.uid;
      allow write: if false;
    }

    match /business_claims/{claimId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'claim_key',
          'owner_user_id',
          'atlas_id',
          'city_name',
          'city_slug',
          'business_name',
          'business_slug',
          'business_address',
          'category',
          'place_id',
          'preview_url',
          'business_plan',
          'business_paid',
          'payment_status',
          'status',
          'created_at'
        ])
        && request.resource.data.claim_key == claimId
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.claim_key is string
        && request.resource.data.claim_key.size() >= 4
        && request.resource.data.claim_key.size() <= 180
        && request.resource.data.city_name is string
        && request.resource.data.city_name.size() >= 2
        && request.resource.data.city_name.size() <= 90
        && request.resource.data.city_slug is string
        && request.resource.data.city_slug.size() >= 2
        && request.resource.data.city_slug.size() <= 90
        && request.resource.data.business_name is string
        && request.resource.data.business_name.size() >= 2
        && request.resource.data.business_name.size() <= 120
        && request.resource.data.business_slug is string
        && request.resource.data.business_slug.size() >= 2
        && request.resource.data.business_slug.size() <= 90
        && request.resource.data.business_address is string
        && request.resource.data.business_address.size() <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.preview_url is string
        && request.resource.data.preview_url.matches('https://livingwiki\\.com/.*')
        && (
          !request.resource.data.keys().hasAny(['business_plan'])
          || request.resource.data.business_plan in ['free', 'local', 'favorite', 'sponsor']
        )
        && (
          !request.resource.data.keys().hasAny(['business_paid'])
          || request.resource.data.business_paid == true
        )
        && (
          !request.resource.data.keys().hasAny(['payment_status'])
          || request.resource.data.payment_status == 'paid'
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && !exists(/databases/$(database)/documents/business_claims/$(claimId));
      allow update: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.claim_key == resource.data.claim_key
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'business_address',
          'category',
          'updated_at'
        ])
        && request.resource.data.business_address is string
        && request.resource.data.business_address.size() <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.updated_at == request.time
      ) || (
        isPlatformAdmin()
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.claim_key == resource.data.claim_key
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updated_at'
        ])
        && request.resource.data.status in ['pending', 'verified', 'rejected']
        && request.resource.data.updated_at == request.time
      );
      allow delete: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
      ) || isPlatformAdmin();
    }

    match /business_claim_requests/{claimId} {
      allow read: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
      ) || isPlatformAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'claim_key',
          'owner_user_id',
          'city_name',
          'city_slug',
          'business_name',
          'business_slug',
          'business_address',
          'category',
          'preview_url',
          'admin_name',
          'admin_email',
          'guide_prompt',
          'badge_icons',
          'business_plan',
          'ai_tone',
          'business_documents_enabled',
          'payment_status',
          'business_paid',
          'status',
          'created_at'
        ])
        && request.resource.data.claim_key == claimId
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.claim_key is string
        && request.resource.data.claim_key.size() >= 4
        && request.resource.data.claim_key.size() <= 180
        && request.resource.data.city_name is string
        && request.resource.data.city_name.size() >= 2
        && request.resource.data.city_name.size() <= 90
        && request.resource.data.city_slug is string
        && request.resource.data.city_slug.size() >= 2
        && request.resource.data.city_slug.size() <= 90
        && request.resource.data.business_name is string
        && request.resource.data.business_name.size() >= 2
        && request.resource.data.business_name.size() <= 120
        && request.resource.data.business_slug is string
        && request.resource.data.business_slug.size() >= 2
        && request.resource.data.business_slug.size() <= 90
        && request.resource.data.business_address is string
        && request.resource.data.business_address.size() <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.preview_url is string
        && request.resource.data.preview_url.matches('https://livingwiki\\.com/.*')
        && request.resource.data.admin_name is string
        && request.resource.data.admin_name.size() >= 2
        && request.resource.data.admin_name.size() <= 90
        && request.resource.data.admin_email is string
        && request.resource.data.admin_email.size() >= 5
        && request.resource.data.admin_email.size() <= 140
        && request.resource.data.admin_email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.guide_prompt is string
        && request.resource.data.guide_prompt.size() <= 5000
        && request.resource.data.badge_icons is list
        && request.resource.data.badge_icons.size() <= 4
        && (
          !request.resource.data.keys().hasAny(['business_plan'])
          || request.resource.data.business_plan in ['free', 'local', 'favorite', 'sponsor']
        )
        && (
          !request.resource.data.keys().hasAny(['ai_tone'])
          || request.resource.data.ai_tone in ['warm', 'calm', 'upbeat', 'professional', 'concise', 'premium']
        )
        && (
          !request.resource.data.keys().hasAny(['business_documents_enabled'])
          || request.resource.data.business_documents_enabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['payment_status'])
          || request.resource.data.payment_status == 'paid'
        )
        && (
          !request.resource.data.keys().hasAny(['business_paid'])
          || request.resource.data.business_paid == true
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && !exists(/databases/$(database)/documents/business_claim_requests/$(claimId));
      allow update: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.claim_key == resource.data.claim_key
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'city_name',
          'city_slug',
          'business_name',
          'business_slug',
          'business_address',
          'category',
          'preview_url',
          'admin_name',
          'admin_email',
          'guide_prompt',
          'badge_icons',
          'business_plan',
          'ai_tone',
          'business_documents_enabled',
          'payment_status',
          'business_paid',
          'logo_url',
          'profile_image_url',
          'cover_image_url',
          'status',
          'created_at',
          'updated_at'
        ])
        && request.resource.data.city_name is string
        && request.resource.data.city_name.size() >= 2
        && request.resource.data.city_name.size() <= 90
        && request.resource.data.city_slug is string
        && request.resource.data.city_slug.size() >= 2
        && request.resource.data.city_slug.size() <= 90
        && request.resource.data.business_name is string
        && request.resource.data.business_name.size() >= 2
        && request.resource.data.business_name.size() <= 120
        && request.resource.data.business_slug is string
        && request.resource.data.business_slug.size() >= 2
        && request.resource.data.business_slug.size() <= 90
        && request.resource.data.business_address is string
        && request.resource.data.business_address.size() <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.preview_url is string
        && request.resource.data.preview_url.matches('https://livingwiki\\.com/.*')
        && request.resource.data.admin_name is string
        && request.resource.data.admin_name.size() >= 2
        && request.resource.data.admin_name.size() <= 90
        && request.resource.data.admin_email is string
        && request.resource.data.admin_email.size() >= 5
        && request.resource.data.admin_email.size() <= 140
        && request.resource.data.admin_email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.guide_prompt is string
        && request.resource.data.guide_prompt.size() <= 5000
        && request.resource.data.badge_icons is list
        && request.resource.data.badge_icons.size() <= 4
        && (
          !request.resource.data.keys().hasAny(['business_plan'])
          || request.resource.data.business_plan in ['free', 'local', 'favorite', 'sponsor']
        )
        && (
          !request.resource.data.keys().hasAny(['ai_tone'])
          || request.resource.data.ai_tone in ['warm', 'calm', 'upbeat', 'professional', 'concise', 'premium']
        )
        && (
          !request.resource.data.keys().hasAny(['business_documents_enabled'])
          || request.resource.data.business_documents_enabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['payment_status'])
          || request.resource.data.payment_status in ['idle', 'checkout_started', 'paid', 'cancelled']
        )
        && (
          !request.resource.data.keys().hasAny(['business_paid'])
          || request.resource.data.business_paid is bool
        )
        && (
          !request.resource.data.keys().hasAny(['logo_url'])
          || (
            request.resource.data.logo_url is string
            && request.resource.data.logo_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['profile_image_url'])
          || (
            request.resource.data.profile_image_url is string
            && request.resource.data.profile_image_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['cover_image_url'])
          || (
            request.resource.data.cover_image_url is string
            && request.resource.data.cover_image_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['pending', 'verified', 'rejected']
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            !resource.data.keys().hasAny(['status'])
            && request.resource.data.status == 'pending'
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['created_at'])
          || request.resource.data.created_at == request.time
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updated_at'])
          || request.resource.data.updated_at == request.time
        )
      ) || (
        isPlatformAdmin()
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.claim_key == resource.data.claim_key
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updated_at'
        ])
        && request.resource.data.status in ['pending', 'verified', 'rejected']
        && request.resource.data.updated_at == request.time
      );
      allow delete: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
      ) || isPlatformAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
