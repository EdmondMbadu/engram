        )
        && (
          !request.resource.data.keys().hasAny(['showCardNumbers'])
          || request.resource.data.showCardNumbers is bool
        )
        && request.resource.data.stickers is list
        && request.resource.data.stickers.size() <= 48
        && (
          !request.resource.data.keys().hasAny(['tourMeta'])
          || request.resource.data.tourMeta == null
          || request.resource.data.tourMeta is map
        )
        && (
          !request.resource.data.keys().hasAny(['learningQuiz'])
          || request.resource.data.learningQuiz == null
          || (
            request.resource.data.learningQuiz is map
            && request.resource.data.learningQuiz.keys().hasOnly([
              'id',
              'title',
              'description',
              'published',
              'leaderboardEnabled',
              'allowGuestNames',
              'questions',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.learningQuiz.id is string
            && request.resource.data.learningQuiz.id.size() >= 1
            && request.resource.data.learningQuiz.id.size() <= 160
            && request.resource.data.learningQuiz.title is string
            && request.resource.data.learningQuiz.title.size() >= 1
            && request.resource.data.learningQuiz.title.size() <= 120
            && request.resource.data.learningQuiz.description is string
            && request.resource.data.learningQuiz.description.size() <= 300
            && request.resource.data.learningQuiz.published is bool
            && request.resource.data.learningQuiz.leaderboardEnabled is bool
            && request.resource.data.learningQuiz.allowGuestNames is bool
            && request.resource.data.learningQuiz.questions is list
            && request.resource.data.learningQuiz.questions.size() >= 3
            && request.resource.data.learningQuiz.questions.size() <= 12
            && request.resource.data.learningQuiz.createdAt is string
            && request.resource.data.learningQuiz.createdAt.size() <= 80
            && request.resource.data.learningQuiz.updatedAt is string
            && request.resource.data.learningQuiz.updatedAt.size() <= 80
          )
        )
        && request.resource.data.cards is list
        && request.resource.data.cards.size() <= 200
        && request.resource.data.created_at_iso is string
        && request.resource.data.updated_at_iso is string
        && request.resource.data.server_updated_at == request.time;
      allow delete: if isSignedIn()
        && (resource.data.owner_user_id == request.auth.uid || isPlatformAdmin());
    }

    match /city_board_listings/{listingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /board_generation_jobs/{jobId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /board_generation_items/{itemId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /board_generation_suppressions/{suppressionId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /board_generation_audit/{auditId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /business_claim_requests/{claimId} {
      allow read: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
      ) || isPlatformAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'claim_key',
          'owner_user_id',
          'city_name',
          'city_slug',
          'business_name',
          'business_slug',
          'business_address',
          'category',
          'preview_url',
          'admin_name',
          'admin_email',
          'guide_prompt',
          'badge_icons',
          'additional_qr_label',
          'additional_qr_url',
          'business_plan',
          'ai_tone',
          'business_documents_enabled',
          'payment_status',
          'business_paid',
          'status',
          'created_at'
        ])
        && request.resource.data.claim_key == claimId
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.claim_key is string
        && request.resource.data.claim_key.size() >= 4
        && request.resource.data.claim_key.size() <= 180
        && request.resource.data.city_name is string
        && request.resource.data.city_name.size() >= 2
        && request.resource.data.city_name.size() <= 90
        && request.resource.data.city_slug is string
        && request.resource.data.city_slug.size() >= 2
        && request.resource.data.city_slug.size() <= 90
        && request.resource.data.business_name is string
        && request.resource.data.business_name.size() >= 2
        && request.resource.data.business_name.size() <= 120
        && request.resource.data.business_slug is string
        && request.resource.data.business_slug.size() >= 2
        && request.resource.data.business_slug.size() <= 90
        && request.resource.data.business_address is string
        && request.resource.data.business_address.size() <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.preview_url is string
        && request.resource.data.preview_url.matches('https://livingwiki\\.com/.*')
        && request.resource.data.admin_name is string
        && request.resource.data.admin_name.size() >= 2
        && request.resource.data.admin_name.size() <= 90
        && request.resource.data.admin_email is string
        && request.resource.data.admin_email.size() >= 5
        && request.resource.data.admin_email.size() <= 140
        && request.resource.data.admin_email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.guide_prompt is string
        && request.resource.data.guide_prompt.size() <= 5000
        && request.resource.data.badge_icons is list
        && request.resource.data.badge_icons.size() <= 4
        && (
          !request.resource.data.keys().hasAny(['additional_qr_label'])
          || (
            request.resource.data.additional_qr_label is string
            && request.resource.data.additional_qr_label.size() <= 120
          )
        )
        && (
          !request.resource.data.keys().hasAny(['additional_qr_url'])
          || (
            request.resource.data.additional_qr_url is string
            && request.resource.data.additional_qr_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['business_plan'])
          || request.resource.data.business_plan in ['free', 'local', 'favorite', 'sponsor']
        )
        && (
          !request.resource.data.keys().hasAny(['ai_tone'])
          || request.resource.data.ai_tone in ['warm', 'calm', 'upbeat', 'professional', 'concise', 'premium']
        )
        && (
          !request.resource.data.keys().hasAny(['business_documents_enabled'])
          || request.resource.data.business_documents_enabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['payment_status'])
          || request.resource.data.payment_status == 'paid'
        )
        && (
          !request.resource.data.keys().hasAny(['business_paid'])
          || request.resource.data.business_paid == true
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && !exists(/databases/$(database)/documents/business_claim_requests/$(claimId));
      allow update: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.claim_key == resource.data.claim_key
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'city_name',
          'city_slug',
          'business_name',
          'business_slug',
          'business_address',
          'category',
          'preview_url',
          'admin_name',
          'admin_email',
          'guide_prompt',
          'badge_icons',
          'business_plan',
          'ai_tone',
          'business_documents_enabled',
          'payment_status',
          'business_paid',
          'logo_url',
          'profile_image_url',
          'cover_image_url',
          'additional_qr_label',
          'additional_qr_url',
          'status',
          'created_at',
          'updated_at'
        ])
        && request.resource.data.city_name is string
        && request.resource.data.city_name.size() >= 2
        && request.resource.data.city_name.size() <= 90
        && request.resource.data.city_slug is string
        && request.resource.data.city_slug.size() >= 2
        && request.resource.data.city_slug.size() <= 90
        && request.resource.data.business_name is string
        && request.resource.data.business_name.size() >= 2
        && request.resource.data.business_name.size() <= 120
        && request.resource.data.business_slug is string
        && request.resource.data.business_slug.size() >= 2
        && request.resource.data.business_slug.size() <= 90
        && request.resource.data.business_address is string
        && request.resource.data.business_address.size() <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.preview_url is string
        && request.resource.data.preview_url.matches('https://livingwiki\\.com/.*')
        && request.resource.data.admin_name is string
        && request.resource.data.admin_name.size() >= 2
        && request.resource.data.admin_name.size() <= 90
        && request.resource.data.admin_email is string
        && request.resource.data.admin_email.size() >= 5
        && request.resource.data.admin_email.size() <= 140
        && request.resource.data.admin_email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.guide_prompt is string
        && request.resource.data.guide_prompt.size() <= 5000
        && request.resource.data.badge_icons is list
        && request.resource.data.badge_icons.size() <= 4
        && (
          !request.resource.data.keys().hasAny(['additional_qr_label'])
          || (
            request.resource.data.additional_qr_label is string
            && request.resource.data.additional_qr_label.size() <= 120
          )
        )
        && (
          !request.resource.data.keys().hasAny(['additional_qr_url'])
          || (
            request.resource.data.additional_qr_url is string
            && request.resource.data.additional_qr_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['business_plan'])
          || request.resource.data.business_plan in ['free', 'local', 'favorite', 'sponsor']
        )
        && (
          !request.resource.data.keys().hasAny(['ai_tone'])
          || request.resource.data.ai_tone in ['warm', 'calm', 'upbeat', 'professional', 'concise', 'premium']
        )
        && (
          !request.resource.data.keys().hasAny(['business_documents_enabled'])
          || request.resource.data.business_documents_enabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['payment_status'])
          || request.resource.data.payment_status in ['idle', 'checkout_started', 'paid', 'cancelled']
        )
        && (
          !request.resource.data.keys().hasAny(['business_paid'])
          || request.resource.data.business_paid is bool
        )
        && (
          !request.resource.data.keys().hasAny(['logo_url'])
          || (
            request.resource.data.logo_url is string
            && request.resource.data.logo_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['profile_image_url'])
          || (
            request.resource.data.profile_image_url is string
            && request.resource.data.profile_image_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['cover_image_url'])
          || (
            request.resource.data.cover_image_url is string
            && request.resource.data.cover_image_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['pending', 'verified', 'rejected']
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            !resource.data.keys().hasAny(['status'])
            && request.resource.data.status == 'pending'
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['created_at'])
          || request.resource.data.created_at == request.time
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updated_at'])
          || request.resource.data.updated_at == request.time
        )
      ) || (
        isPlatformAdmin()
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.claim_key == resource.data.claim_key
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updated_at'
        ])
        && request.resource.data.status in ['pending', 'verified', 'rejected']
        && request.resource.data.updated_at == request.time
      );
      allow delete: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
      ) || isPlatformAdmin();
    }

    // Analytics are written and read only through validated Cloud Functions.
    // Keeping these collections opaque prevents authors from inflating counters
    // or discovering another board's traffic details with direct SDK calls.
    match /board_analytics_daily_shards/{documentId} {
      allow read, write: if false;
    }

    match /board_analytics_event_receipts/{documentId} {
      allow read, write: if false;
    }

    match /board_analytics_unique_receipts/{documentId} {
      allow read, write: if false;
    }

    match /board_analytics_rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
